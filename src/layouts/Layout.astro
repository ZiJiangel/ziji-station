---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props { title: string; description?: string; hideNav?: boolean; }
const { title, description = '朋友们的数字客厅', hideNav = false } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
  </head>
  <body>
    {!hideNav && (
      <header class="top-nav">
        <a href="/" class="logo">ZIJI.STATION</a>
        <nav class="nav-links">
          <a href="/">大厅</a>
          <a href="/dashboard">写作</a>
          <a href="/arcade">游戏厅</a>
        </nav>
        <div class="nav-actions">
          <button id="theme-toggle" class="theme-btn" title="切换主题">
            <svg id="icon-sun" style="display:none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            <svg id="icon-moon" style="display:none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <a href="/login" id="nav-login" class="btn btn-primary" style="padding: 6px 16px; font-size: 13px;">登录</a>
          <a href="/editor" id="nav-editor" class="btn btn-ghost" style="display:none; padding: 6px 16px; font-size: 13px;">工作室</a>
          <div class="user-menu" id="user-menu" style="display:none">
            <div id="nav-avatar" class="avatar" role="button" tabindex="0" aria-label="用户菜单" aria-haspopup="true" aria-expanded="false"></div>
            <div class="menu-panel" id="menu-panel" role="menu" hidden>
              <a href="#" id="menu-profile" role="menuitem">我的主页</a>
              <a href="/settings" role="menuitem">设置</a>
              <button type="button" id="menu-logout" role="menuitem">退出登录</button>
            </div>
          </div>
        </div>
      </header>
    )}
    <slot />
    <script>
      import { supabase } from '../lib/supabase';

      function updateIcons() {
        const iconSun = document.getElementById('icon-sun');
        const iconMoon = document.getElementById('icon-moon');
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (iconSun) iconSun.style.display = isDark ? 'block' : 'none';
        if (iconMoon) iconMoon.style.display = isDark ? 'none' : 'block';
      }

      function applySession(session) {
        const lb = document.getElementById('nav-login');
        const eb = document.getElementById('nav-editor');
        const menu = document.getElementById('user-menu');
        const av = document.getElementById('nav-avatar');
        const panel = document.getElementById('menu-panel');
        const profileLink = document.getElementById('menu-profile');
        const logoutBtn = document.getElementById('menu-logout');
        if (!lb || !eb || !menu || !av || !panel) return;

        if (session) {
          const u = localStorage.getItem('ziji_user') || 'U';
          lb.style.display = 'none';
          eb.style.display = 'inline-flex';
          menu.style.display = 'block';
          av.textContent = u.charAt(0).toUpperCase();
          av.title = u;
          if (profileLink) profileLink.setAttribute('href', '/' + u);

          if (av.dataset.bound !== '1') {
            av.dataset.bound = '1';
            const toggle = (e) => {
              e.stopPropagation();
              const open = panel.hidden;
              panel.hidden = !open;
              av.setAttribute('aria-expanded', String(open));
            };
            av.addEventListener('click', toggle);
            av.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(e); }
              if (e.key === 'Escape') { panel.hidden = true; av.setAttribute('aria-expanded', 'false'); }
            });
            document.addEventListener('click', (e) => {
              if (!panel.hidden && !menu.contains(e.target)) {
                panel.hidden = true;
                av.setAttribute('aria-expanded', 'false');
              }
            });
          }
          if (logoutBtn && logoutBtn.dataset.bound !== '1') {
            logoutBtn.dataset.bound = '1';
            logoutBtn.addEventListener('click', async () => {
              await supabase.auth.signOut();
              localStorage.removeItem('ziji_uid');
              localStorage.removeItem('ziji_user');
              window.location.href = '/';
            });
          }
        } else {
          lb.style.display = 'inline-flex';
          eb.style.display = 'none';
          menu.style.display = 'none';
          panel.hidden = true;
        }
      }

      function bindNav() {
        // ViewTransitions 切页后 html 属性会被重置，需重新应用主题
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        if (document.documentElement.getAttribute('data-theme') !== theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }
        updateIcons();
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle && !themeToggle.dataset.bound) {
          themeToggle.dataset.bound = '1';
          themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateIcons();
          });
        }
      }

      // 每次页面就绪都重绑主题 + 重新读一次 session（ViewTransitions 会替换导航栏 DOM）
      function refresh() {
        bindNav();
        supabase.auth.getSession().then(({ data }) => applySession(data.session));
      }
      refresh();
      supabase.auth.onAuthStateChange((_e, session) => applySession(session));
      document.addEventListener('astro:after-swap', () => { bindNav(); });
      document.addEventListener('astro:page-load', refresh);
    </script>
  </body>
</html>

<style>
  .top-nav {
    position: fixed; top: 0; left: 0; right: 0; height: 64px;
    background: var(--nav-bg); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; z-index: 100; max-width: 1400px; margin: 0 auto;
    transition: background-color 0.3s;
  }
  .logo { font-family: var(--font-mono); font-weight: 600; font-size: 14px; letter-spacing: 0.05em; }
  .nav-links { display: flex; gap: 24px; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); font-weight: 500; transition: color 0.2s; }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-actions { display: flex; gap: 12px; align-items: center; }
  
  .theme-btn {
    display: grid; place-items: center;
    width: 32px; height: 32px; border-radius: 50%;
    color: var(--text-secondary); border: 1px solid var(--border);
    transition: all 0.2s;
  }
  .theme-btn:hover { color: var(--text-primary); border-color: var(--border-light); background: var(--bg-surface); }
  
  .avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--bg-elevated); color: var(--text-primary); font-size: 12px; font-weight: 600; display: grid; place-items: center; cursor: pointer; border: 1px solid var(--border); transition: border-color 0.15s; }
  .avatar:hover { border-color: var(--border-light); }
  .avatar:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 3px; }
  .user-menu { position: relative; }
  .menu-panel { position: absolute; top: calc(100% + 8px); right: 0; min-width: 160px; padding: 6px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: 0 8px 24px rgba(0,0,0,0.12); display: flex; flex-direction: column; z-index: 200; }
  .menu-panel[hidden] { display: none; }
  .menu-panel a, .menu-panel button { display: block; width: 100%; text-align: left; padding: 9px 12px; font-size: 13px; color: var(--text-secondary); border-radius: var(--radius-sm); transition: background 0.15s, color 0.15s; }
  .menu-panel a:hover, .menu-panel button:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .menu-panel a:focus-visible, .menu-panel button:focus-visible { outline: 2px solid var(--text-primary); outline-offset: -2px; }
</style>
