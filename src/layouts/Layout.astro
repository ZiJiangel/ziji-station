---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
}
const { title, description = '子骥的小站 · 构建你的数字自留地', hideNav = false } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    {!hideNav && (
      <header class="nav-header">
        <a href="/" class="nav-brand">
          <div class="brand-icon">z</div>
          <span>子骥的小站</span>
        </a>
        
        <nav class="nav-links">
          <a href="/">大厅</a>
          <a href="/dashboard">内容库</a>
          <a href="/arcade">游戏厅</a>
        </nav>
        
        <div class="nav-actions">
          <a href="/login" id="nav-login" class="btn btn-primary">登录 / 入驻</a>
          <a href="/editor" id="nav-editor" class="btn btn-ghost" style="display:none">编辑器</a>
          <div id="nav-avatar" class="nav-avatar" style="display:none"></div>
        </div>
      </header>
    )}

    <div class={hideNav ? "" : "page-wrapper"}>
      <slot />
    </div>

    <script>
      const user = localStorage.getItem('ziji_user');
      if (user) {
        const loginBtn = document.getElementById('nav-login');
        const editorBtn = document.getElementById('nav-editor');
        const avatar = document.getElementById('nav-avatar');
        if (loginBtn) loginBtn.style.display = 'none';
        if (editorBtn) editorBtn.style.display = 'inline-flex';
        if (avatar) {
          avatar.style.display = 'grid';
          avatar.innerText = user.charAt(0).toUpperCase();
          avatar.onclick = () => window.location.href = '/' + user;
        }
      }
    </script>
  </body>
</html>

<style>
  .nav-header {
    position: fixed; top: 0; left: 0; right: 0; height: 64px;
    background: rgba(9, 9, 11, 0.7);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; z-index: 100;
  }
  .nav-brand {
    display: flex; align-items: center; gap: 12px;
    font-weight: 700; font-size: 16px; color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .brand-icon {
    width: 28px; height: 28px; border-radius: 8px;
    background: linear-gradient(135deg, var(--accent), #818cf8);
    color: #000; display: grid; place-items: center;
    font-family: var(--font-hand); font-size: 18px;
    box-shadow: 0 0 12px var(--accent-glow);
  }
  .nav-links {
    display: flex; gap: 8px;
  }
  .nav-links a {
    padding: 8px 16px; border-radius: 99px;
    font-size: 14px; font-weight: 500; color: var(--text-secondary);
    transition: all 0.2s;
  }
  .nav-links a:hover {
    color: var(--text-primary); background: var(--bg-surface);
  }
  .nav-actions {
    display: flex; align-items: center; gap: 12px;
  }
  .nav-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--bg-elevated); color: var(--accent);
    font-weight: 600; font-size: 14px; cursor: pointer;
    border: 1px solid var(--border); transition: all 0.2s;
  }
  .nav-avatar:hover { border-color: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }
  
  .page-wrapper {
    padding-top: 64px;
    min-height: 100vh;
  }
  
  @media (max-width: 640px) {
    .nav-links { display: none; }
  }
</style>
