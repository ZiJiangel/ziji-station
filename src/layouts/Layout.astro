162:     <script>
163:       import { supabase } from '../lib/supabase';
164: 
165:       function setupTheme() {
166:         const btn = document.getElementById('theme-btn');
167:         const panel = document.getElementById('theme-panel');
168:         
169:         if (btn && panel && btn.dataset.bound !== '1') {
170:           btn.dataset.bound = '1';
171:           btn.addEventListener('click', (e) => {
172:             e.stopPropagation();
173:             panel.hidden = !panel.hidden;
174:           });
175:           document.addEventListener('click', (e) => {
176:             if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== btn) {
177:               panel.hidden = true;
178:             }
179:           });
180:           
181:           panel.querySelectorAll('.theme-option').forEach(opt => {
182:             opt.addEventListener('click', () => {
183:               const theme = (opt as HTMLElement).dataset.themeVal;
184:               if (theme) {
185:                 document.documentElement.setAttribute('data-theme', theme);
186:                 localStorage.setItem('theme', theme);
187:                 panel.hidden = true;
188:               }
189:             });
190:           });
191:         }
192:       }
193: 
194:       function applySession(session) {
195:         const lb = document.getElementById('nav-login');
196:         const db = document.getElementById('nav-draft');
197:         const sb = document.getElementById('nav-settings');
198:         const menu = document.getElementById('user-menu');
199:         const av = document.getElementById('nav-avatar');
200:         const panel = document.getElementById('menu-panel');
201:         const profileLink = document.getElementById('menu-profile');
202:         const logoutBtn = document.getElementById('menu-logout');
203:         if (!lb || !menu || !av || !panel) return;
204: 
205:         if (session) {
206:           const u = localStorage.getItem('ziji_user') || 'U';
207:           lb.style.display = 'none';
208:           menu.style.display = 'block';
209:           if (db) db.style.display = 'inline-flex';
210:           if (sb) sb.style.display = 'flex';
211:           
212:           av.textContent = u.charAt(0).toUpperCase();
213:           av.title = u;
214:           if (profileLink) profileLink.setAttribute('href', '/' + u);
215: 
216:           if (av.dataset.bound !== '1') {
217:             av.dataset.bound = '1';
218:             const toggle = (e) => {
219:               e.stopPropagation();
220:               const open = panel.hidden;
221:               panel.hidden = !open;
222:             };
223:             av.addEventListener('click', toggle);
224:             document.addEventListener('click', (e) => {
225:               if (!panel.hidden && !menu.contains(e.target)) panel.hidden = true;
226:             });
227:           }
228:           if (logoutBtn && logoutBtn.dataset.bound !== '1') {
229:             logoutBtn.dataset.bound = '1';
230:             logoutBtn.addEventListener('click', async () => {
231:               await supabase.auth.signOut();
232:               localStorage.removeItem('ziji_uid');
233:               localStorage.removeItem('ziji_user');
234:               window.location.href = '/';
235:             });
236:           }
237:         } else {
238:           lb.style.display = 'flex';
239:           menu.style.display = 'none';
240:           if (db) db.style.display = 'none';
241:           if (sb) sb.style.display = 'none';
242:           panel.hidden = true;
243:         }
244:       }
245: 
246:       function refresh() {
247:         setupTheme();
248:         supabase.auth.getSession().then(({ data }) => applySession(data.session));
249:         
250:         const bnUser = document.getElementById('bn-user');
251:         if (bnUser) {
252:           const u = localStorage.getItem('ziji_user');
253:           if (u) bnUser.setAttribute('href', '/' + u);
254:           else bnUser.setAttribute('href', '/login');
255:         }
256:       }
257:       refresh();
258:       supabase.auth.onAuthStateChange((_e, session) => applySession(session));
259:       document.addEventListener('astro:page-load', refresh);
260:     </script>
