---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
}
const { title, description = '子骥的小站 · 记录生活的角落', hideNav = false } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    {!hideNav && (
      <header style="position: sticky; top: 0; z-index: 50; height: 64px; background: oklch(0.96 0.018 75 / 0.82); backdrop-filter: blur(16px); border-bottom: 1px solid var(--line-soft); display: flex; align-items: center; padding: 0 28px; gap: 28px;">
        <a href="/" style="display: flex; align-items: center; gap: 10px; font-family: var(--font-round); font-size: 18px; font-weight: 800; color: var(--ink);">
          <span style="width: 32px; height: 32px; border-radius: 10px; background: var(--accent); color: white; display: grid; place-items: center; font-family: var(--font-hand); font-size: 20px; transform: rotate(-4deg); box-shadow: 0 2px 0 var(--accent-deep);">z</span>
          子骥的小站
        </a>
        <nav style="display: flex; gap: 4px; height: 100%;">
          <a href="/" style="height: 100%; padding: 0 16px; display: flex; align-items: center; font-family: var(--font-round); font-size: 14px; font-weight: 700; color: var(--muted); text-decoration: none;">大厅</a>
          <a href="/dashboard" style="height: 100%; padding: 0 16px; display: flex; align-items: center; font-family: var(--font-round); font-size: 14px; font-weight: 700; color: var(--muted); text-decoration: none;">内容库</a>
          <a href="/arcade" style="height: 100%; padding: 0 16px; display: flex; align-items: center; font-family: var(--font-round); font-size: 14px; font-weight: 700; color: var(--muted); text-decoration: none;">游戏厅</a>
        </nav>
        <div style="margin-left: auto; display: flex; gap: 10px;">
          <a href="/login" id="nav-login" class="ak-btn ak-btn--pri">登录 / 入驻</a>
          <a href="/editor" id="nav-editor" class="ak-btn ak-btn--soft" style="display:none">进入编辑器</a>
        </div>
      </header>
    )}
    <div style={hideNav ? "" : "padding-top: 20px;"}>
      <slot />
    </div>
    <script>
      if (localStorage.getItem('ziji_user')) {
        document.getElementById('nav-login')!.style.display = 'none';
        document.getElementById('nav-editor')!.style.display = 'inline-flex';
      }
    </script>
  </body>
</html>
