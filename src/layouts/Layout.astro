---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
}
const { title, description = '子骥的小站 · 个人主页与动态大厅', hideNav = false } = Astro.props;
const user = Astro.locals?.user;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <ViewTransitions />
    <title>{title}</title>
  </head>
  <body>
    {!hideNav && (
      <header class="nav">
        <div class="nav-left">
          <a href="/" class="brand">ZIJI.STATION</a>
          <nav class="nav-links">
            <a href="/">动态大厅</a>
            <a href="/dashboard">内容管理</a>
            <a href="/arcade">游戏厅</a>
          </nav>
        </div>
        <div id="nav-actions" class="nav-actions">
          <a href="/login" id="nav-login" class="btn-login">登录</a>
          <a href="/editor" id="nav-editor" class="btn-editor" style="display:none">进入编辑器</a>
          <div id="nav-avatar" class="nav-avatar" style="display:none"></div>
        </div>
      </header>
    )}

    <div class={hideNav ? '' : 'page-body'}>
      <slot />
    </div>

    <script>
      import { gsap } from 'gsap';
      (window as any).gsap = gsap;

      const user = localStorage.getItem('ziji_user');
      if (user) {
        const loginBtn = document.getElementById('nav-login');
        const editorBtn = document.getElementById('nav-editor');
        const avatar = document.getElementById('nav-avatar');
        if (loginBtn) loginBtn.style.display = 'none';
        if (editorBtn) editorBtn.style.display = 'inline-block';
        if (avatar) {
          avatar.style.display = 'grid';
          avatar.innerText = user.charAt(0).toUpperCase();
          avatar.onclick = () => (window.location.href = '/' + user);
        }
      }
    </script>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: rgba(20, 20, 20, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid #2a2a2a;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    color: #18d1ff;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.12em;
  }
  .nav-links {
    display: flex;
    gap: 20px;
  }
  .nav-links a {
    color: #888;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: #d2d2d2; }
  .nav-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .btn-login {
    color: #18d1ff;
    text-decoration: none;
    font-size: 13px;
  }
  .btn-editor {
    color: #000;
    background: #18d1ff;
    padding: 6px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }
  .nav-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2a2a2a;
    color: #18d1ff;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .page-body { padding-top: 60px; }

  @media (max-width: 640px) {
    .nav { padding: 0 16px; }
    .nav-links { display: none; }
  }
</style>
