---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

const { title = '朋友们的数字客厅', description = '朋友们的数字客厅', hideNav = false } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      (function () {
        var THEMES = ['ink', 'moss', 'ember'];
        var root = document.documentElement;
        var t = localStorage.getItem('zj-theme');
        var m = localStorage.getItem('zj-mode');
        if (THEMES.indexOf(t) === -1) t = 'ink';
        if (m !== 'light' && m !== 'dark') {
          m = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', t);
        root.setAttribute('data-mode', m);
      })();
    </script>
  </head>
  <body>
    {!hideNav ? (
      <div class="app-shell">
        <header class="app-topbar">
          <a href="/" class="brand">
            <div class="brand-mark">Z</div>
            <div class="brand-text">
              <span class="brand-name">子骥的小站</span>
              <span class="brand-sub">friends only</span>
            </div>
          </a>

          <div class="topbar-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
            <input type="text" placeholder="搜索文章、动态、成员…" />
          </div>

          <div class="topbar-actions">
            <div class="theme-picker">
              <button id="theme-btn" class="icon-btn" title="外观" aria-haspopup="true" aria-expanded="false" aria-controls="theme-panel">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.8v2.2M12 20v2.2M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M1.8 12h2.2M20 12h2.2M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56"/></svg>
              </button>
              <div class="theme-panel" id="theme-panel" role="dialog" aria-label="外观设置" hidden>
                <div class="tp-label">色相</div>
                <div class="tp-hues" role="radiogroup" aria-label="色相">
                  <button class="tp-hue" data-hue="ink"   role="radio" aria-checked="true"  title="墨蓝" style="--sw: oklch(0.60 0.15 250)"><span></span>墨蓝</button>
                  <button class="tp-hue" data-hue="moss"  role="radio" aria-checked="false" title="苔绿" style="--sw: oklch(0.56 0.13 145)"><span></span>苔绿</button>
                  <button class="tp-hue" data-hue="ember" role="radio" aria-checked="false" title="陶橙" style="--sw: oklch(0.66 0.16 40)"><span></span>陶橙</button>
                </div>
                <div class="rule" style="margin:10px 0"></div>
                <div class="tp-mode-row">
                  <span class="tp-label" style="margin:0">明暗</span>
                  <button class="switch" id="mode-switch" role="switch" aria-checked="false" aria-label="切换明暗"><span class="visually-hidden">切换明暗</span></button>
                </div>
              </div>
            </div>
            
            <a href="/dashboard" class="draft-btn" id="nav-draft" style="display:none">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              <span>写点什么</span>
            </a>

            <a href="/login" id="nav-login" class="btn btn-primary" style="display:flex;">登录</a>
            <div class="user-menu" id="user-menu" style="display:none">
              <div id="nav-avatar" class="avatar" role="button" tabindex="0"></div>
              <div class="menu-panel" id="menu-panel" role="menu" hidden>
                <a href="#" id="menu-profile" role="menuitem">我的主页</a>
                <a href="/settings" role="menuitem">设置</a>
                <button type="button" id="menu-logout" role="menuitem" style="color:var(--danger)">退出登录</button>
              </div>
            </div>
          </div>
        </header>

        <aside class="app-sidebar">
          <nav class="side-nav">
            <div class="nav-group">主菜单</div>
            <a href="/" class="nav-item" data-path="/">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.6V21h13V9.6"/><path d="M10 21v-6h4v6"/></svg>
              首页
            </a>
            <a href="/articles" class="nav-item" data-path="/articles">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              文章
            </a>
            <a href="/moments" class="nav-item" data-path="/moments">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 11h16M4 16h10"/></svg>
              动态
            </a>
            <a href="/gallery" class="nav-item" data-path="/gallery">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4 17 5-5 4 4 3-3 4 4"/></svg>
              相册
            </a>
            <a href="/arcade" class="nav-item" data-path="/arcade">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="19" height="11" rx="5"/><path d="M7.5 11v4M5.5 13h4M16 12.5h.01M18.5 15h.01"/></svg>
              游戏
            </a>

            <div class="nav-group">站点</div>
            <a href="/members" class="nav-item" data-path="/members">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1.4A4.6 4.6 0 0 1 7.6 14h2.8A4.6 4.6 0 0 1 15 18.6V20"/><path d="M16 5.4a3 3 0 0 1 0 5.6M17.2 14a4.6 4.6 0 0 1 3.8 4.5V20"/></svg>
              成员
            </a>
            <a href="/invites" class="nav-item" data-path="/invites">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/><path d="M19 3v4M17 5h4"/></svg>
              邀请
            </a>
            <a href="/about" class="nav-item" data-path="/about">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
              关于
            </a>
            <a href="/settings" class="nav-item" data-path="/settings" id="nav-settings" style="display:none">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="var(--bg-surface)"/><circle cx="15" cy="12" r="2" fill="var(--bg-surface)"/><circle cx="8" cy="17" r="2" fill="var(--bg-surface)"/></svg>
              设置
            </a>
          </nav>
          <div class="side-foot">
            基于 Astro · Supabase<br/>邀请制 · 私有空间
          </div>
        </aside>

        <main class="app-content">
          <div class="stage-inner">
            <slot />
          </div>
        </main>

        <nav class="bottom-nav">
          <a href="/" class="bn-item" data-path="/">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.6V21h13V9.6"/><path d="M10 21v-6h4v6"/></svg>
            <span>首页</span>
          </a>
          <a href="/articles" class="bn-item" data-path="/articles">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
            <span>文章</span>
          </a>
          <a href="/moments" class="bn-item" data-path="/moments">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 11h16M4 16h10"/></svg>
            <span>动态</span>
          </a>
          <a href="/arcade" class="bn-item" data-path="/arcade">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="19" height="11" rx="5"/><path d="M7.5 11v4M5.5 13h4M16 12.5h.01M18.5 15h.01"/></svg>
            <span>游戏</span>
          </a>
          <a href="#" id="bn-user" class="bn-item" data-path="user">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20v-1.4A5.6 5.6 0 0 1 9.6 13h4.8a5.6 5.6 0 0 1 5.6 5.6V20"/></svg>
            <span>我的</span>
          </a>
        </nav>
      </div>
    ) : (
      <slot />
    )}

    <script src="/layout.js" is:inline></script>
  </body>
</html>

<style>
  .app-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    grid-template-rows: 58px 1fr;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .app-topbar { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; padding: 0 20px; background: var(--nav-bg); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); z-index: 20; }
  .brand { display: flex; align-items: center; gap: 9px; min-width: 200px; text-decoration: none; }
  .brand-mark { width: 30px; height: 30px; background: var(--text-primary); color: var(--bg); border-radius: 9px; display: grid; place-items: center; font-weight: 700; font-size: 16px; font-family: var(--font-serif); }
  .brand-text { display: flex; align-items: baseline; gap: 6px; }
  .brand-name { font-family: var(--font-serif); font-size: 18px; font-weight: 600; color: var(--text-primary); }
  .brand-sub { font-size: 11px; color: var(--text-muted); }
  .topbar-search { position: relative; flex: 1; max-width: 380px; }
  .topbar-search svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .topbar-search input { width: 100%; height: 34px; background: var(--bg-elevated); border: 1px solid transparent; border-radius: var(--radius-sm); padding: 0 12px 0 34px; font-size: 13px; outline: none; color: var(--text-primary); transition: all 0.15s; }
  .topbar-search input:focus { border-color: var(--border-light); background: var(--bg-surface); }
  .topbar-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .icon-btn { width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius-sm); color: var(--text-secondary); background: transparent; border: none; cursor: pointer; transition: all 0.15s; }
  .icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .draft-btn { height: 34px; display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; background: transparent; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 12.5px; color: var(--text-secondary); text-decoration: none; cursor: pointer; transition: all 0.15s; }
  .draft-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }
  .avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--text-primary); color: var(--bg); font-size: 13px; font-weight: 600; display: grid; place-items: center; cursor: pointer; margin-left: 4px; }
  .user-menu { position: relative; }
  .menu-panel { position: absolute; top: calc(100% + 8px); right: 0; min-width: 160px; padding: 6px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: 0 8px 24px rgba(0,0,0,0.12); display: flex; flex-direction: column; z-index: 200; }
  .menu-panel[hidden] { display: none; }
  .menu-panel a, .menu-panel button { display: block; width: 100%; text-align: left; padding: 9px 12px; font-size: 13px; color: var(--text-secondary); border-radius: var(--radius-sm); transition: background 0.15s; }
  .menu-panel a:hover, .menu-panel button:hover { background: var(--bg-elevated); color: var(--text-primary); }

  .theme-picker { position: relative; }
  .theme-panel {
    position: absolute; top: calc(100% + 10px); right: 0; width: 208px; padding: 12px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: 0 12px 32px oklch(0 0 0 / .14), 0 2px 6px oklch(0 0 0 / .06);
    display: flex; flex-direction: column; z-index: 200;
    transform-origin: top right;
    animation: tpIn var(--dur-base) var(--ease-out) both;
  }
  @keyframes tpIn { from { opacity: 0; transform: scale(.96) translateY(-4px); } to { opacity: 1; transform: none; } }
  .theme-panel[hidden] { display: none; }
  .tp-label { font-size: 10.5px; letter-spacing: .07em; color: var(--muted); font-weight: 600; margin: 0 0 8px; text-transform: uppercase; }

  .tp-hues { display: flex; flex-direction: column; gap: 2px; }
  .tp-hue {
    display: flex; align-items: center; gap: 10px; padding: 7px 9px;
    font-size: 13px; color: var(--secondary); border-radius: var(--radius-sm);
    cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast);
    position: relative;
  }
  .tp-hue:hover { background: var(--elevated); color: var(--primary); }
  .tp-hue span {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / .08);
    transition: transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base);
    flex: 0 0 auto;
  }
  .tp-hue.on { color: var(--primary); font-weight: 600; }
  .tp-hue.on span { transform: scale(1.12); box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--sw); }
  .tp-hue.on::after {
    content: ""; margin-left: auto; width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    animation: dotIn var(--dur-base) var(--ease-spring) both;
  }
  @keyframes dotIn { from { transform: scale(0); } to { transform: scale(1); } }

  .tp-mode-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }

  :global(.switch) {
    width: 38px; height: 22px; border-radius: 99px;
    background: var(--border-hi); position: relative;
    transition: background var(--dur-base) var(--ease-out);
    flex: 0 0 auto; cursor: pointer; border: none; padding: 0;
  }
  :global(.switch)::after {
    content: ""; position: absolute; top: 2px; left: 2px;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--surface); box-shadow: 0 1px 3px oklch(0 0 0 / .22);
    transition: transform var(--dur-base) var(--ease-spring), background var(--dur-base);
  }
  :global(.switch.on) { background: var(--accent); }
  :global(.switch.on)::after { transform: translateX(16px); background: var(--bg); }
  :global(.switch:active)::after { width: 22px; }
  :global(.switch.on:active)::after { transform: translateX(12px); }

  .app-sidebar { background: var(--bg-surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 18px 10px 20px; overflow-y: auto; }
  .nav-group { font-size: 10.5px; color: var(--text-muted); letter-spacing: 0.06em; padding: 0 10px; margin: 0 0 8px; font-weight: 600; }
  .nav-group:not(:first-child) { margin-top: 22px; }
  .nav-item { width: 100%; height: 38px; display: flex; align-items: center; gap: 11px; padding: 0 11px; margin-bottom: 2px; border-radius: var(--radius-sm); color: var(--text-secondary); font-size: 13.5px; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-item:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .nav-item.active { background: var(--bg-elevated); color: var(--text-primary); font-weight: 600; }
  .side-foot { margin-top: auto; padding: 24px 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); line-height: 1.8; }

  .app-content { overflow-y: auto; overflow-x: hidden; background: var(--bg); position: relative; }
  .stage-inner { max-width: 920px; margin: 0 auto; padding: 28px 30px 80px; animation: fadeIn 0.26s ease both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .bottom-nav { display: none; }

  @media (max-width: 760px) {
    .app-shell { grid-template-columns: 1fr; grid-template-rows: 58px 1fr 56px; }
    .app-sidebar { display: none; }
    .app-topbar { padding: 0 16px; }
    .topbar-search { display: none; }
    .brand { min-width: auto; }
    .brand-text, .draft-btn span { display: none; }
    .stage-inner { padding: 20px 16px; }
    .app-content { margin-bottom: 56px; }
    
    .bottom-nav {
      display: flex;
      align-items: center;
      justify-content: space-around;
      background: var(--bg-surface);
      border-top: 1px solid var(--border);
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 56px;
      z-index: 30;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .bn-item {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      color: var(--text-muted); font-size: 10px; text-decoration: none;
      padding: 6px 0; width: 20%; transition: color 0.15s;
    }
    .bn-item.active { color: var(--text-primary); font-weight: 600; }
    .bn-item svg { width: 22px; height: 22px; }
  }

  .reveal { opacity: 0; transform: translateY(12px); animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  @keyframes revealUp { to { opacity: 1; transform: translateY(0); } }
  .reveal-delay-1 { animation-delay: 0.1s; }
  .reveal-delay-2 { animation-delay: 0.2s; }
  .reveal-delay-3 { animation-delay: 0.3s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; opacity: 1; transform: none; }
  }

  :global(.pagehead) { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  :global(.pagehead h1) { font-size: 23px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 5px; line-height: 1.35; color: var(--text-primary); }
  :global(.pagehead p) { margin: 0; font-size: 12.5px; color: var(--text-secondary); max-width: 52em; line-height: 1.7; }
  :global(.pagehead .actions) { display: flex; gap: 8px; flex: 0 0 auto; align-items: center; }

  :global(.card) { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 18px 20px; transition: border-color 0.2s, box-shadow 0.2s; }
  :global(.card:hover) { border-color: var(--border-light); box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
  :global(.card.tight) { padding: 14px 16px; }
  :global(.card.flat) { background: transparent; border: 0; padding: 0; }

  :global(.btn) { height: 34px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-secondary); font-size: 12.5px; font-weight: 500; transition: all 0.2s var(--ease-out); white-space: nowrap; cursor: pointer; text-decoration: none; }
  :global(.btn:hover) { background: var(--bg-elevated); border-color: var(--text-muted); color: var(--text-primary); }
  :global(.btn:active) { transform: translateY(1px) scale(0.98); }
  :global(.btn.primary) { background: var(--text-primary); border-color: var(--text-primary); color: var(--bg); }
  :global(.btn.primary:hover) { opacity: 0.9; }
  :global(.btn.ghost) { background: transparent; border-color: transparent; }
  :global(.btn.ghost:hover) { background: var(--bg-elevated); }
  :global(.btn.sm) { height: 28px; padding: 0 10px; font-size: 11.5px; }
  :global(.btn[disabled]) { opacity: 0.45; pointer-events: none; }

  :global(.tag) { font-size: 10.5px; color: var(--text-muted); border: 1px solid var(--border); padding: 1px 7px; border-radius: 99px; white-space: nowrap; }
  :global(.tag.ready) { color: var(--text-primary); background: var(--bg-elevated); border-color: transparent; }

  :global(input.f), :global(textarea.f), :global(select.f) { width: 100%; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 11px; font-size: 13px; outline: none; transition: border-color 0.15s; color: var(--text-primary); }
  :global(input.f:focus), :global(textarea.f:focus) { border-color: var(--text-muted); }
  :global(textarea.f) { resize: vertical; line-height: 1.75; }
  :global(label.fl) { display: block; font-size: 12px; color: var(--text-secondary); margin: 0 0 6px; font-weight: 500; }
  :global(.field) { margin-bottom: 14px; }

  :global(.switch-row) { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--border); }
