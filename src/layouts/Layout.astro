117:     <script>
118:       import { supabase } from '../lib/supabase';
119: 
120:       function updateIcons() {
121:         const iconSun = document.getElementById('icon-sun');
122:         const iconMoon = document.getElementById('icon-moon');
123:         const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
124:         if (iconSun) iconSun.style.display = isDark ? 'block' : 'none';
125:         if (iconMoon) iconMoon.style.display = isDark ? 'none' : 'block';
126:       }
127: 
128:       function applySession(session) {
129:         const lb = document.getElementById('nav-login');
130:         const db = document.getElementById('nav-draft');
131:         const sb = document.getElementById('nav-settings');
132:         const menu = document.getElementById('user-menu');
133:         const av = document.getElementById('nav-avatar');
134:         const panel = document.getElementById('menu-panel');
135:         const profileLink = document.getElementById('menu-profile');
136:         const logoutBtn = document.getElementById('menu-logout');
137:         if (!lb || !menu || !av || !panel) return;
138: 
139:         if (session) {
140:           const u = localStorage.getItem('ziji_user') || 'U';
141:           lb.style.display = 'none';
142:           menu.style.display = 'block';
143:           if (db) db.style.display = 'inline-flex';
144:           if (sb) sb.style.display = 'flex';
145:           
146:           av.textContent = u.charAt(0).toUpperCase();
147:           av.title = u;
148:           if (profileLink) profileLink.setAttribute('href', '/' + u);
149: 
150:           if (av.dataset.bound !== '1') {
151:             av.dataset.bound = '1';
152:             const toggle = (e) => {
153:               e.stopPropagation();
154:               const open = panel.hidden;
155:               panel.hidden = !open;
156:             };
157:             av.addEventListener('click', toggle);
158:             document.addEventListener('click', (e) => {
159:               if (!panel.hidden && !menu.contains(e.target)) panel.hidden = true;
160:             });
161:           }
162:           if (logoutBtn && logoutBtn.dataset.bound !== '1') {
163:             logoutBtn.dataset.bound = '1';
164:             logoutBtn.addEventListener('click', async () => {
165:               await supabase.auth.signOut();
166:               localStorage.removeItem('ziji_uid');
167:               localStorage.removeItem('ziji_user');
168:               window.location.href = '/';
169:             });
170:           }
171:         } else {
172:           lb.style.display = 'flex';
173:           menu.style.display = 'none';
174:           if (db) db.style.display = 'none';
175:           if (sb) sb.style.display = 'none';
176:           panel.hidden = true;
177:         }
178:       }
179: 
180:       function bindNav() {
181:         const saved = localStorage.getItem('theme');
182:         const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
183:         const theme = saved || (prefersDark ? 'dark' : 'light');
184:         if (document.documentElement.getAttribute('data-theme') !== theme) {
185:           document.documentElement.setAttribute('data-theme', theme);
186:         }
187:         updateIcons();
188:         const themeToggle = document.getElementById('theme-toggle');
189:         if (themeToggle && !themeToggle.dataset.bound) {
190:           themeToggle.dataset.bound = '1';
191:           themeToggle.addEventListener('click', () => {
192:             const current = document.documentElement.getAttribute('data-theme');
193:             const next = current === 'dark' ? 'light' : 'dark';
194:             document.documentElement.setAttribute('data-theme', next);
195:             localStorage.setItem('theme', next);
196:             updateIcons();
197:           });
198:         }
199:       }
200: 
201:       function refresh() {
202:         bindNav();
203:         supabase.auth.getSession().then(({ data }) => applySession(data.session));
204:       }
205:       refresh();
206:       supabase.auth.onAuthStateChange((_e, session) => applySession(session));
207:       document.addEventListener('astro:page-load', refresh);
208:     </script>
209:   </body>
