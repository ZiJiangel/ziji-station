---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props { title: string; description?: string; hideNav?: boolean; }
const { title, description = '朋友们的数字客厅', hideNav = false } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
  </head>
  <body>
    {!hideNav ? (
      <div class="app-shell">
        <header class="app-topbar">
          <a href="/" class="brand">
            <div class="brand-mark">Z</div>
            <div class="brand-text">
              <span class="brand-name">子骥的小站</span>
              <span class="brand-sub">friends only</span>
            </div>
          </a>

          <div class="topbar-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
            <input type="text" placeholder="搜索文章、动态、成员…" />
          </div>

          <div class="topbar-actions">
            <button id="theme-toggle" class="icon-btn" title="切换主题">
              <svg id="icon-sun" style="display:none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M2 12h2M20 12h2M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5"/></svg>
              <svg id="icon-moon" style="display:none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
            </button>
            
            <a href="/dashboard" class="draft-btn" id="nav-draft" style="display:none">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              <span>写点什么</span>
            </a>

            <a href="/login" id="nav-login" class="btn btn-primary" style="display:flex;">登录</a>
            <div class="user-menu" id="user-menu" style="display:none">
              <div id="nav-avatar" class="avatar" role="button" tabindex="0"></div>
              <div class="menu-panel" id="menu-panel" role="menu" hidden>
                <a href="#" id="menu-profile" role="menuitem">我的主页</a>
                <a href="/settings" role="menuitem">设置</a>
                <button type="button" id="menu-logout" role="menuitem" style="color:var(--danger)">退出登录</button>
              </div>
            </div>
          </div>
        </header>

        <aside class="app-sidebar">
          <nav class="side-nav">
            <div class="nav-group">主菜单</div>
            <a href="/" class={`nav-item ${isActive('/') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.6V21h13V9.6"/><path d="M10 21v-6h4v6"/></svg>
              首页
            </a>
            <a href="/articles" class={`nav-item ${isActive('/articles') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              文章
            </a>
            <a href="/moments" class={`nav-item ${isActive('/moments') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 11h16M4 16h10"/></svg>
              动态
            </a>
            <a href="/gallery" class={`nav-item ${isActive('/gallery') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4 17 5-5 4 4 3-3 4 4"/></svg>
              相册
            </a>
            <a href="/arcade" class={`nav-item ${isActive('/arcade') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="19" height="11" rx="5"/><path d="M7.5 11v4M5.5 13h4M16 12.5h.01M18.5 15h.01"/></svg>
              游戏
            </a>

            <div class="nav-group">站点</div>
            <a href="/about" class={`nav-item ${isActive('/about') ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
              关于
            </a>
            <a href="/settings" class={`nav-item ${isActive('/settings') ? 'active' : ''}`} id="nav-settings" style="display:none">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="var(--bg-surface)"/><circle cx="15" cy="12" r="2" fill="var(--bg-surface)"/><circle cx="8" cy="17" r="2" fill="var(--bg-surface)"/></svg>
              设置
            </a>
          </nav>
          <div class="side-foot">
            基于 Astro · Supabase<br/>邀请制 · 私有空间
          </div>
        </aside>

        <main class="app-content">
          <div class="stage-inner">
            <slot />
          </div>
        </main>
      </div>
    ) : (
      <slot />
    )}

    <script>
      import { supabase } from '../lib/supabase';

      function updateIcons() {
        const iconSun = document.getElementById('icon-sun');
        const iconMoon = document.getElementById('icon-moon');
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (iconSun) iconSun.style.display = isDark ? 'block' : 'none';
        if (iconMoon) iconMoon.style.display = isDark ? 'none' : 'block';
      }

      function applySession(session) {
        const lb = document.getElementById('nav-login');
        const db = document.getElementById('nav-draft');
        const sb = document.getElementById('nav-settings');
        const menu = document.getElementById('user-menu');
        const av = document.getElementById('nav-avatar');
        const panel = document.getElementById('menu-panel');
        const profileLink = document.getElementById('menu-profile');
        const logoutBtn = document.getElementById('menu-logout');
        if (!lb || !menu || !av || !panel) return;

        if (session) {
          const u = localStorage.getItem('ziji_user') || 'U';
          lb.style.display = 'none';
          menu.style.display = 'block';
          if (db) db.style.display = 'inline-flex';
          if (sb) sb.style.display = 'flex';
          
          av.textContent = u.charAt(0).toUpperCase();
          av.title = u;
          if (profileLink) profileLink.setAttribute('href', '/' + u);

          if (av.dataset.bound !== '1') {
            av.dataset.bound = '1';
            const toggle = (e) => {
              e.stopPropagation();
              const open = panel.hidden;
              panel.hidden = !open;
            };
            av.addEventListener('click', toggle);
            document.addEventListener('click', (e) => {
              if (!panel.hidden && !menu.contains(e.target)) panel.hidden = true;
            });
          }
          if (logoutBtn && logoutBtn.dataset.bound !== '1') {
            logoutBtn.dataset.bound = '1';
            logoutBtn.addEventListener('click', async () => {
              await supabase.auth.signOut();
              localStorage.removeItem('ziji_uid');
              localStorage.removeItem('ziji_user');
              window.location.href = '/';
            });
          }
        } else {
          lb.style.display = 'flex';
          menu.style.display = 'none';
          if (db) db.style.display = 'none';
          if (sb) sb.style.display = 'none';
          panel.hidden = true;
        }
      }

      function bindNav() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        if (document.documentElement.getAttribute('data-theme') !== theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }
        updateIcons();
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle && !themeToggle.dataset.bound) {
          themeToggle.dataset.bound = '1';
          themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateIcons();
          });
        }
      }

      function refresh() {
        bindNav();
        supabase.auth.getSession().then(({ data }) => applySession(data.session));
      }
      refresh();
      supabase.auth.onAuthStateChange((_e, session) => applySession(session));
      document.addEventListener('astro:page-load', refresh);
    </script>
  </body>
</html>

<style>
  .app-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    grid-template-rows: 58px 1fr;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .app-topbar { grid-column: 1 / -1; display: flex; align-items: center; gap: 16px; padding: 0 20px; background: var(--bg-surface); border-bottom: 1px solid var(--border); z-index: 20; }
  .brand { display: flex; align-items: center; gap: 9px; min-width: 200px; text-decoration: none; }
  .brand-mark { width: 30px; height: 30px; background: var(--text-primary); color: var(--bg); border-radius: 9px; display: grid; place-items: center; font-weight: 700; font-size: 16px; font-family: var(--font-serif); }
  .brand-text { display: flex; align-items: baseline; gap: 6px; }
  .brand-name { font-family: var(--font-serif); font-size: 18px; font-weight: 600; color: var(--text-primary); }
  .brand-sub { font-size: 11px; color: var(--text-muted); }
  .topbar-search { position: relative; flex: 1; max-width: 380px; }
  .topbar-search svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .topbar-search input { width: 100%; height: 34px; background: var(--bg-elevated); border: 1px solid transparent; border-radius: var(--radius-sm); padding: 0 12px 0 34px; font-size: 13px; outline: none; color: var(--text-primary); transition: all 0.15s; }
  .topbar-search input:focus { border-color: var(--border-light); background: var(--bg-surface); }
  .topbar-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .icon-btn { width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius-sm); color: var(--text-secondary); background: transparent; border: none; cursor: pointer; transition: all 0.15s; }
  .icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .draft-btn { height: 34px; display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; background: transparent; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 12.5px; color: var(--text-secondary); text-decoration: none; cursor: pointer; transition: all 0.15s; }
  .draft-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }
  .avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--text-primary); color: var(--bg); font-size: 13px; font-weight: 600; display: grid; place-items: center; cursor: pointer; margin-left: 4px; }
  .user-menu { position: relative; }
  .menu-panel { position: absolute; top: calc(100% + 8px); right: 0; min-width: 160px; padding: 6px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: 0 8px 24px rgba(0,0,0,0.12); display: flex; flex-direction: column; z-index: 200; }
  .menu-panel[hidden] { display: none; }
  .menu-panel a, .menu-panel button { display: block; width: 100%; text-align: left; padding: 9px 12px; font-size: 13px; color: var(--text-secondary); border-radius: var(--radius-sm); transition: background 0.15s; }
  .menu-panel a:hover, .menu-panel button:hover { background: var(--bg-elevated); color: var(--text-primary); }

  .app-sidebar { background: var(--bg-surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 18px 10px 20px; overflow-y: auto; }
  .nav-group { font-size: 10.5px; color: var(--text-muted); letter-spacing: 0.06em; padding: 0 10px; margin: 0 0 8px; font-weight: 600; }
  .nav-group:not(:first-child) { margin-top: 22px; }
  .nav-item { width: 100%; height: 38px; display: flex; align-items: center; gap: 11px; padding: 0 11px; margin-bottom: 2px; border-radius: var(--radius-sm); color: var(--text-secondary); font-size: 13.5px; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .nav-item:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .nav-item.active { background: var(--bg-elevated); color: var(--text-primary); font-weight: 600; }
  .side-foot { margin-top: auto; padding: 24px 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); line-height: 1.8; }

  .app-content { overflow-y: auto; overflow-x: hidden; background: var(--bg); position: relative; }
  .stage-inner { max-width: 920px; margin: 0 auto; padding: 28px 30px 80px; animation: fadeIn 0.26s ease both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  @media (max-width: 760px) {
    .app-shell { grid-template-columns: 1fr; }
    .app-sidebar { display: none; }
    .app-topbar { padding: 0 16px; }
    .topbar-search { max-width: 200px; }
    .brand { min-width: auto; }
    .brand-text, .draft-btn span { display: none; }
    .stage-inner { padding: 20px 16px 80px; }
  }

  /* 参考站基础组件 */
  :global(.pagehead) { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  :global(.pagehead h1) { font-size: 23px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 5px; line-height: 1.35; color: var(--text-primary); }
  :global(.pagehead p) { margin: 0; font-size: 12.5px; color: var(--text-secondary); max-width: 52em; line-height: 1.7; }
  :global(.pagehead .actions) { display: flex; gap: 8px; flex: 0 0 auto; align-items: center; }

  :global(.card) { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 18px 20px; }
  :global(.card.tight) { padding: 14px 16px; }
  :global(.card.flat) { background: transparent; border: 0; padding: 0; }

  :global(.btn) { height: 34px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-secondary); font-size: 12.5px; font-weight: 500; transition: all 0.15s; white-space: nowrap; cursor: pointer; text-decoration: none; }
  :global(.btn:hover) { background: var(--bg-elevated); border-color: var(--text-muted); color: var(--text-primary); }
  :global(.btn:active) { transform: translateY(1px); }
  :global(.btn.primary) { background: var(--text-primary); border-color: var(--text-primary); color: var(--bg); }
  :global(.btn.primary:hover) { opacity: 0.9; }
  :global(.btn.ghost) { background: transparent; border-color: transparent; }
  :global(.btn.ghost:hover) { background: var(--bg-elevated); }
  :global(.btn.sm) { height: 28px; padding: 0 10px; font-size: 11.5px; }
  :global(.btn[disabled]) { opacity: 0.45; pointer-events: none; }

  :global(.tag) { font-size: 10.5px; color: var(--text-muted); border: 1px solid var(--border); padding: 1px 7px; border-radius: 99px; white-space: nowrap; }
  :global(.tag.ready) { color: var(--text-primary); background: var(--bg-elevated); border-color: transparent; }

  :global(input.f), :global(textarea.f), :global(select.f) { width: 100%; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 11px; font-size: 13px; outline: none; transition: border-color 0.15s; color: var(--text-primary); }
  :global(input.f:focus), :global(textarea.f:focus) { border-color: var(--text-muted); }
  :global(textarea.f) { resize: vertical; line-height: 1.75; }
  :global(label.fl) { display: block; font-size: 12px; color: var(--text-secondary); margin: 0 0 6px; font-weight: 500; }
  :global(.field) { margin-bottom: 14px; }

  :global(.switch) { width: 36px; height: 20px; border-radius: 99px; background: var(--border-light); position: relative; transition: background 0.2s; flex: 0 0 auto; cursor: pointer; border: none; }
  :global(.switch:after) { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.18); }
  :global(.switch.on) { background: var(--text-primary); }
  :global(.switch.on:after) { transform: translateX(16px); }
  :global(.switch-row) { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--border-light); }
  :global(.switch-row:last-child) { border-bottom: 0; }

  :global(.rule) { height: 1px; background: var(--border); margin: 22px 0; }
  :global(.grid2) { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  :global(.stat-row) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 0 0 22px; }
  :global(.stat) { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 16px; }
  :global(.stat .v) { font-size: 23px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; color: var(--text-primary); }
  :global(.stat .k) { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

  :global(.people) { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 24px; }
  :global(.person) { display: flex; gap: 11px; padding: 13px 2px; border-bottom: 1px solid var(--border-light); align-items: center; cursor: pointer; }
  :global(.pn) { font-size: 13px; font-weight: 600; color: var(--text-primary); }
  :global(.pm) { font-size: 11px; color: var(--text-muted); }

  :global(table.tbl) { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  :global(table.tbl th) { text-align: left; font-weight: 600; font-size: 11px; color: var(--text-muted); padding: 9px 10px; border-bottom: 1px solid var(--border); }
  :global(table.tbl td) { padding: 10px; border-bottom: 1px solid var(--border-light); vertical-align: top; color: var(--text-secondary); }
  :global(table.tbl tr:last-child td) { border-bottom: 0; }
  :global(table.tbl tr:hover td) { background: var(--bg-elevated); }

  :global(.game-grid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  :global(.game-card) { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px; display: flex; flex-direction: column; gap: 8px; min-height: 148px; min-width: 0; }
  :global(.game-card .gname) { font-size: 15px; font-weight: 650; white-space: nowrap; flex: 0 0 auto; color: var(--text-primary); }
  :global(.game-card .gdesc) { font-size: 11.5px; color: var(--text-secondary); line-height: 1.7; flex: 1; }

  :global(.gallery) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  :global(.ph) { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: var(--radius-sm); cursor: zoom-in; background: var(--bg-elevated); border: 1px solid var(--border-light); }
  :global(.ph img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.3, 1); }
  :global(.ph:hover img) { transform: scale(1.04); }
  :global(.ph .cap) { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 10px 8px; color: #fff; font-size: 11px; background: linear-gradient(transparent, rgba(12, 20, 24, 0.75)); opacity: 0; transition: opacity 0.2s; }
  :global(.ph:hover .cap) { opacity: 1; }

  :global(.list) { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  :global(.li) { padding: 16px 18px; border-bottom: 1px solid var(--border-light); display: flex; gap: 14px; transition: background 0.15s; }
  :global(.li:last-child) { border-bottom: 0; }
  :global(.li:hover) { background: var(--bg-elevated); }
  :global(.li .li-body) { flex: 1; min-width: 0; }
  :global(.li-title) { font-size: 15px; font-weight: 600; margin: 0 0 5px; line-height: 1.5; cursor: pointer; color: var(--text-primary); text-decoration: none; display: block; }
  :global(.li-title:hover) { color: var(--text-secondary); }
  :global(.li-excerpt) { font-size: 13px; color: var(--text-secondary); line-height: 1.8; margin: 0 0 9px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.li-meta) { font-size: 11.5px; color: var(--text-muted); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-family: var(--font-mono); }
  :global(.li-side) { flex: 0 0 auto; width: 82px; height: 70px; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border-light); }

  :global(.moment) { padding: 16px 18px; border-bottom: 1px solid var(--border-light); background: var(--bg-surface); }
  :global(.moment:last-child) { border-bottom: 0; }
  :global(.moment-head) { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  :global(.moment-name) { font-size: 13px; font-weight: 600; color: var(--text-primary); text-decoration: none; }
  :global(.moment-time) { font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); }
  :global(.moment-text) { font-size: 14px; line-height: 1.85; white-space: pre-wrap; margin: 0 0 9px; color: var(--text-secondary); }
