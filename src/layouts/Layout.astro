---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  hideNav?: boolean;
}
const { title, hideNav = false } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ViewTransitions />
    <title>{title}</title>
  </head>
  <body style="margin: 0; background: #111; color: #d2d2d2; font-family: 'JetBrains Mono', monospace;">
    
    {!hideNav && (
      <header style="position: fixed; top: 0; left: 0; right: 0; height: 60px; background: rgba(27,27,27,0.8); backdrop-filter: blur(12px); border-bottom: 1px solid #333; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 0 24px;">
        <div style="display: flex; align-items: center; gap: 32px;">
          <a href="/" style="color: #18d1ff; font-size: 18px; font-weight: bold; text-decoration: none; letter-spacing: 0.1em;">ZIJI.STATION</a>
          <nav style="display: flex; gap: 16px;">
            <a href="/" style="color: #d2d2d2; text-decoration: none; font-size: 14px;">动态大厅</a>
            <a href="/dashboard" style="color: #888; text-decoration: none; font-size: 14px;">内容管理</a>
            <a href="/arcade" style="color: #888; text-decoration: none; font-size: 14px;">游戏厅</a>
          </nav>
        </div>
        <div id="nav-actions" style="display: flex; gap: 12px; align-items: center;">
          <a href="/login" id="nav-login" style="color: #18d1ff; text-decoration: none; font-size: 14px;">登录</a>
          <a href="/editor" id="nav-editor" style="display: none; color: #000; background: #18d1ff; padding: 6px 16px; border-radius: 20px; text-decoration: none; font-size: 13px; font-weight: bold;">进入编辑器</a>
          <div id="nav-avatar" style="display: none; width: 32px; height: 32px; border-radius: 50%; background: #333; color: #18d1ff; display: grid; place-items: center; font-size: 14px; cursor: pointer;">Z</div>
        </div>
      </header>
    )}

    <div style="padding-top: 60px;">
      <slot />
    </div>
    
    <script>
      import { gsap } from 'gsap';
      window.gsap = gsap;

      // 检查登录状态并切换导航按钮
      const user = localStorage.getItem('ziji_user');
      if (user) {
        const loginBtn = document.getElementById('nav-login');
        const editorBtn = document.getElementById('nav-editor');
        const avatar = document.getElementById('nav-avatar');
        if (loginBtn) loginBtn.style.display = 'none';
        if (editorBtn) editorBtn.style.display = 'inline-block';
        if (avatar) {
          avatar.style.display = 'grid';
          avatar.innerText = user.charAt(0).toUpperCase();
          avatar.onclick = () => window.location.href = '/' + user;
        }
      }
    </script>
  </body>
</html>