---
import type { ProfileBlock } from '../../lib/blocks';
import { sanitizeText, safeUrl } from '../../lib/sanitize';

interface Props { block: ProfileBlock }
const { block } = Astro.props;
const { avatar, name, bio, status } = block.props;
const avatarUrl = safeUrl(avatar || '');
---

<section class="block profile">
  {avatarUrl && (
    <img class="avatar" src={avatarUrl} alt={sanitizeText(name || '头像')} loading="lazy" />
  )}
  <div class="info">
    {name && <h1 class="name">{sanitizeText(name)}</h1>}
    {status && <p class="status">{sanitizeText(status)}</p>}
    {bio && <p class="bio">{sanitizeText(bio)}</p>}
  </div>
</section>

<style>
  .profile {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 24px;
    background: #1b1b1b;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
  }
  .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #18d1ff33;
    flex-shrink: 0;
  }
  .info { min-width: 0; }
  .name {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    word-break: break-word;
  }
  .status {
    margin: 0 0 8px;
    font-size: 13px;
    color: #18d1ff;
  }
  .bio {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: #999;
    word-break: break-word;
  }
  @media (max-width: 640px) {
    .profile { flex-direction: column; text-align: center; gap: 14px; }
  }
</style>
