---
import type { ArticlesBlock } from '../../lib/blocks';
import { getArticles } from '../../lib/api';

interface Props {
  block: ArticlesBlock;
  userId: string;
}
const { block, userId } = Astro.props;
const items = await getArticles(userId, block.props.limit || 5);
const layout = block.props.layout || 'list';

function fmtDate(s: string) {
  return new Date(s).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<section class="block articles">
  <header class="head">
    <h2>文章</h2>
  </header>
  {items.length === 0 ? (
    <p class="empty">还没有发布文章</p>
  ) : (
    <ul class={"items " + layout}>
      {items.map((a) => (
        <li>
          <a href={"/post/" + a.id} class="item">
            <div class="title">{a.title}</div>
            {a.summary && <div class="summary">{a.summary}</div>}
            <div class="meta">{fmtDate(a.created_at)}</div>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .articles {
    padding: 24px;
    background: #1b1b1b;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
  }
  .head { margin-bottom: 14px; }
  .head h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: #18d1ff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .empty {
    margin: 0;
    color: #555;
    font-size: 14px;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .item {
    display: block;
    padding: 12px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .item:hover { background: #242424; }
  .title {
    font-size: 15px;
    color: #fff;
    font-weight: 500;
    margin-bottom: 4px;
    line-height: 1.5;
  }
  .summary {
    font-size: 13px;
    color: #888;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: 6px;
    font-size: 11px;
    color: #555;
  }
  .items.card {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .items.card .item {
    border: 1px solid #2a2a2a;
    height: 100%;
  }
</style>
