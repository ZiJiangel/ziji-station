---
import type { LinksBlock } from '../../lib/blocks';
import { sanitizeText, safeUrl } from '../../lib/sanitize';

interface Props { block: LinksBlock }
const { block } = Astro.props;
const valid = block.props.links
  .map(l => ({ label: sanitizeText(l.label), url: safeUrl(l.url) }))
  .filter(l => l.url && l.label);
---

{valid.length > 0 && (
  <section class="block links">
    {valid.map(l => (
      <a href={l.url!} target="_blank" rel="noopener noreferrer nofollow" class="link">
        {l.label}
      </a>
    ))}
  </section>
)}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .link {
    padding: 8px 18px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .link:hover {
    border-color: var(--border-light);
    color: var(--text-primary);
  }
</style>
