---
import type { Block } from '../../lib/blocks';
import { getArticles, getMoments } from '../../lib/api';
import { sanitizeText, renderMarkdown, safeUrl } from '../../lib/sanitize';

interface Props { block: Block; userId: string; }
const { block, userId } = Astro.props;

function fmtDate(s: string) {
  return new Date(s).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

{block.type === 'profile' && (
  <section class="profile-card card reveal">
    <div class="p-inner">
      {block.props.avatar && <img class="avatar" src={safeUrl(block.props.avatar) || ''} alt="avatar" />}
      <div class="p-info">
        {block.props.name && <h1>{sanitizeText(block.props.name)}</h1>}
        {block.props.status && <div class="status"><span class="dot"></span>{sanitizeText(block.props.status)}</div>}
        {block.props.bio && <p class="bio">{sanitizeText(block.props.bio)}</p>}
      </div>
    </div>
  </section>
)}

{block.type === 'markdown' && (
  <section class="markdown-card card reveal" set:html={renderMarkdown(block.props.content)} />
)}

{block.type === 'links' && (
  <section class="links-row reveal">
    {block.props.links.map(l => {
      const url = safeUrl(l.url);
      return url ? <a href={url} target="_blank" rel="noopener noreferrer" class="link-btn">{sanitizeText(l.label)}</a> : null;
    })}
  </section>
)}

{block.type === 'articles' && (async () => {
  const items = await getArticles(userId, block.props.limit);
  if (items.length === 0) return null;
  return (
    <section class="articles-card card reveal">
      <h2 class="sec-title">最新文章</h2>
      <div class="a-list">
        {items.map(a => (
          <a href={"/post/" + a.id} class="a-item">
            <h3>{sanitizeText(a.title)}</h3>
            {a.summary && <p>{sanitizeText(a.summary)}</p>}
            <span class="meta">{fmtDate(a.published_at)}</span>
          </a>
        ))}
      </div>
    </section>
  );
})()}

{block.type === 'moments' && (async () => {
  const items = await getMoments(userId, block.props.limit);
  if (items.length === 0) return null;
  return (
    <section class="moments-card card reveal">
      <h2 class="sec-title">碎碎念</h2>
      <div class="m-list">
        {items.map(m => (
          <div class="m-item">
            <div class="m-text">{sanitizeText(m.content)}</div>
            <div class="m-time">{fmtDate(m.created_at)}</div>
          </div>
        ))}
      </div>
    </section>
  );
})()}

<style>
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.3s;
  }
  .card:hover { border-color: var(--border-hover); }
  
  /* Profile */
  .profile-card { padding: 40px; }
  .p-inner { display: flex; gap: 24px; align-items: center; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); }
  .p-info h1 { font-size: 28px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; letter-spacing: -0.02em; }
  .status { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--accent); margin-bottom: 12px; font-weight: 500; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .bio { font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0; }

  /* Markdown */
  .markdown-card { font-size: 15px; line-height: 1.8; color: var(--text-secondary); }
  .markdown-card :global(h2) { font-size: 20px; margin: 0 0 16px 0; color: var(--text-primary); }
  .markdown-card :global(h3) { font-size: 17px; margin: 16px 0 8px 0; color: var(--text-primary); }
  .markdown-card :global(p) { margin-bottom: 1em; }
  .markdown-card :global(a) { color: var(--accent); text-decoration: underline; }

  /* Links */
  .links-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .link-btn {
    padding: 10px 20px; background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: 99px; font-size: 14px; color: var(--text-secondary); transition: all 0.2s;
  }
  .link-btn:hover { border-color: var(--accent); color: var(--text-primary); transform: translateY(-2px); }

  /* Shared */
  .sec-title { font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border); font-weight: 500; }
  
  /* Articles */
  .a-list { display: flex; flex-direction: column; gap: 16px; }
  .a-item { display: block; padding: 16px; background: var(--bg-base); border: 1px solid var(--border); border-radius: var(--radius-md); text-decoration: none; transition: border-color 0.2s; }
  .a-item:hover { border-color: var(--border-hover); }
  .a-item h3 { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
  .a-item p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .a-item .meta { font-size: 12px; color: var(--text-muted); }

  /* Moments */
  .m-list { display: flex; flex-direction: column; gap: 20px; }
  .m-item { padding-left: 20px; border-left: 2px solid var(--border); position: relative; }
  .m-item::before { content: ""; position: absolute; left: -5px; top: 6px; width: 8px; height: 8px; border-radius: 50%; background: var(--border); }
  .m-text { font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 8px; white-space: pre-wrap; }
  .m-time { font-size: 12px; color: var(--text-muted); }

  @media (max-width: 640px) {
    .card { padding: 24px; }
    .profile-card { padding: 32px 24px; }
    .p-inner { flex-direction: column; text-align: center; gap: 16px; }
  }
</style>
