---
import type { Block } from '../../lib/blocks';
import ProfileBlock from './ProfileBlock.astro';
import MarkdownBlock from './MarkdownBlock.astro';
import LinksBlock from './LinksBlock.astro';
import ArticlesBlock from './ArticlesBlock.astro';
import MomentsBlock from './MomentsBlock.astro';
import GalleryBlock from './GalleryBlock.astro';

interface Props {
  blocks: Block[];
  userId: string;
}
const { blocks, userId } = Astro.props;
const visible = blocks.filter(b => b.visible);
---

<div class="blocks">
  {visible.map((block) => {
    switch (block.type) {
      case 'profile': return <ProfileBlock block={block} />;
      case 'markdown': return <MarkdownBlock block={block} />;
      case 'links': return <LinksBlock block={block} />;
      case 'articles': return <ArticlesBlock block={block} userId={userId} />;
      case 'moments': return <MomentsBlock block={block} userId={userId} />;
      case 'gallery': return <GalleryBlock block={block} />;
    }
  })}
</div>

<style>
  .blocks {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 20px 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (max-width: 640px) {
    .blocks { padding: 32px 16px 64px; gap: 16px; }
  }
</style>
