---
import Layout from '../layouts/Layout.astro';
---
<Layout title="首页 · 子骥的小站">
  <div class="row between" style="margin-bottom: 20px;">
    <div class="wrap">
      <button class="chip on">全部</button>
      <button class="chip">文章</button>
      <button class="chip">动态</button>
    </div>
    <span class="tiny muted" id="feed-count">加载中…</span>
  </div>

  <div id="feed-container" class="list"></div>
  <div class="row" style="justify-content: center; gap: 8px; margin-top: 20px;">
    <a href="/articles" class="chip">全部文章</a>
    <a href="/gallery" class="chip">全部照片</a>
  </div>

  <script>
    import { getFeed } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      if (diff < 0) return '刚刚';
      const min = Math.floor(diff / 60000);
      if (min < 1) return '刚刚';
      if (min < 60) return min + ' 分钟前';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + ' 小时前';
      const day = Math.floor(hr / 24);
      if (day < 7) return day + ' 天前';
      return d.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
    }

    async function loadFeed() {
      const el = document.getElementById('feed-container');
      const countEl = document.getElementById('feed-count');
      if (!el) return;
      try {
        const { moments, articles } = await getFeed(30);
        const all = [
          ...moments.map((m: any) => ({ ...m, _type: 'moment' })),
          ...articles.map((a: any) => ({ ...a, _type: 'article' })),
        ].sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());

        if (countEl) countEl.textContent = `${all.length} 条更新`;

        if (all.length === 0) {
          el.innerHTML = '<div class="empty"><span class="big">这里还没有内容</span>去写作台发布第一条吧。</div>';
          return;
        }

        el.innerHTML = all.map((item: any) => {
          const p = item.profiles || {};
          const name = sanitizeText(p.display_name || p.username || '匿名');
          const initial = name.charAt(0).toUpperCase();
          const isArticle = item._type === 'article';
          
          if (isArticle) {
            return `
              <div class="li">
                <div class="li-body">
                  <a href="/post/${item.id}" class="li-title">${sanitizeText(item.title)}</a>
                  <p class="li-excerpt">${sanitizeText(item.summary || '')}</p>
                  <div class="li-meta">
                    <span>${name}</span><span>·</span><span>${fmtTime(item.published_at)}</span>
                    <span class="feed-kind" style="margin-left:6px">文章</span>
                  </div>
                </div>
                ${item.cover_url ? `<div class="li-side"><img src="${item.cover_url}" style="width:100%;height:100%;object-fit:cover;"/></div>` : ''}
              </div>
            `;
          } else {
            return `
              <div class="moment">
                <div class="moment-head">
                  <div class="avatar-sm">${initial}</div>
                  <a href="/${p.username || '#'}" class="moment-name">${name}</a>
                  <span class="feed-kind">动态</span>
                  <span class="moment-time">${fmtTime(item.created_at)}</span>
                </div>
                <p class="moment-text">${sanitizeText(item.content)}</p>
                ${item.images && item.images.length > 0 
                  ? `<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px;">${item.images.map((img: string) => `<div style="aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border);"><img src="${img}" style="width:100%;height:100%;object-fit:cover;" loading="lazy"/></div>`).join('')}</div>` 
                  : ''
                }
              </div>
            `;
          }
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }
    loadFeed();
    document.addEventListener('astro:page-load', loadFeed);
  </script>
</Layout>
