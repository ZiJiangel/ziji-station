---
import Layout from '../layouts/Layout.astro';
---
<Layout title="子骥的小站 · Akari">
  <!-- build-version: 1794307564770 -->
  <!-- 欢迎动画层 -->
  <div id="welcome" style="position:fixed; inset:0; z-index:1000; background:var(--paper); display:flex; align-items:center; justify-content:center; flex-direction:column; text-align:center; padding:24px; transition: opacity .8s var(--ease-out), visibility .8s;">
    <div style="position:relative; z-index:1;">
      <div style="width:10px; height:10px; border-radius:50%; background:var(--accent); margin:0 auto 20px; box-shadow:0 0 0 6px var(--accent-soft); animation:pulse 2s infinite;"></div>
      <div style="font-family:var(--font-hand); font-size:26px; color:var(--accent-deep); margin-bottom:6px; transform:rotate(-2deg);">Welcome to</div>
      <h1 style="font-family:var(--font-round); font-size:clamp(30px,5.5vw,52px); font-weight:800; color:var(--ink); margin-bottom:12px;">子骥的小站</h1>
      <p style="font-size:15px; color:var(--ink-2); margin-bottom:32px;">在代码与文字之间寻找平衡。</p>
      <button id="enter-btn" class="ak-btn ak-btn--pri" style="height:52px; padding:0 32px; font-size:16px; animation:breathe 2.4s infinite;">开启旅程</button>
    </div>
  </div>

  <main style="max-width:800px; margin:0 auto; padding:40px 20px 80px;">
    <!-- 发动态 -->
    <section id="composer" class="ak-card" style="padding:20px; margin-bottom:32px; display:none;">
      <textarea id="moment-input" placeholder="此刻的碎碎念..." style="width:100%; height:80px; background:transparent; border:none; outline:none; resize:none; font-family:var(--font-body); font-size:15px; color:var(--ink);"></textarea>
      <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--line-soft); padding-top:12px; margin-top:8px;">
        <span style="font-size:12px; color:var(--muted);">上限 300 字</span>
        <button id="publish-btn" class="ak-btn ak-btn--pri">发布</button>
      </div>
    </section>

    <!-- 信息流 -->
    <section>
      <h2 style="font-family:var(--font-round); font-size:18px; color:var(--ink); margin-bottom:16px;">动态大厅</h2>
      <div id="feed-container" style="display:flex; flex-direction:column; gap:16px;"></div>
    </section>
  </main>

  <script>
    import { getFeed, createMoment } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';
    import { gsap } from 'gsap';

    // 欢迎动画
    const welcome = document.getElementById('welcome');
    document.getElementById('enter-btn')?.addEventListener('click', () => {
      welcome.style.opacity = '0';
      welcome.style.visibility = 'hidden';
      gsap.fromTo('main', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
    });

    const composer = document.getElementById('composer');
    if (localStorage.getItem('ziji_uid')) composer.style.display = 'block';

    function fmtTime(s) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + ' 小时前';
      return Math.floor(hr / 24) + ' 天前';
    }

    async function loadFeed() {
      const el = document.getElementById('feed-container');
      const { moments, articles } = await getFeed(30);
      const all = [
        ...moments.map((m: any) => ({ ...m, _type: 'moment' })),
        ...articles.map((a: any) => ({ ...a, _type: 'article' })),
      ].sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());

      if (all.length === 0) {
        el.innerHTML = '<p style="color:var(--muted);text-align:center;">还没有动态。</p>';
        return;
      }

      el.innerHTML = all.map((item: any) => {
        const profile = item.profiles || {};
        const name = sanitizeText(profile.display_name || profile.username || '匿名');
        return `
          <div class="ak-card" style="padding:20px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
              <a href="/${profile.username}" style="font-family:var(--font-round); font-weight:700; color:var(--accent-deep);">${name}</a>
              <span style="font-size:12px; color:var(--muted);">${fmtTime(item.published_at || item.created_at)}</span>
            </div>
            ${item._type === 'article' 
              ? `<a href="/post/${item.id}" style="display:block; font-size:16px; font-weight:700; color:var(--ink); margin-bottom:6px;">${sanitizeText(item.title)}</a><p style="color:var(--muted); font-size:14px;">${sanitizeText(item.summary || '')}</p>`
              : `<p style="font-size:14.5px; color:var(--ink-2); line-height:1.7; white-space:pre-wrap;">${sanitizeText(item.content)}</p>`
            }
          </div>
        `;
      }).join('');
    }

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      const input = document.getElementById('moment-input');
      if (!uid || !input.value.trim()) return;
      await createMoment(uid, input.value.trim());
      input.value = '';
      loadFeed();
    });

    document.addEventListener('DOMContentLoaded', loadFeed);
  </script>
</Layout>
