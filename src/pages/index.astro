---
import Layout from '../layouts/Layout.astro';
---
<Layout title="子骥的小站 · 大厅">
  <main class="home-main">
    <!-- Hero 区 -->
    <section class="hero">
      <div class="hero-badge">✨ 邀请制私人社区</div>
      <h1 class="hero-title animate-fade-up">构建属于你的<br><span class="gradient-text">数字自留地</span></h1>
      <p class="hero-desc animate-fade-up" style="animation-delay: 0.1s">抛弃算法的喧嚣。在这里，用区块流排版，搭建一个纯粹的、有厚度的个人主页。</p>
      <div class="hero-actions animate-fade-up" style="animation-delay: 0.2s">
        <a href="/login" class="btn btn-primary">创建我的主页</a>
        <a href="/arcade" class="btn btn-ghost">闲逛游戏厅</a>
      </div>
    </section>

    <!-- 发布框 -->
    <section id="composer" class="composer card" style="display:none;">
      <textarea id="moment-input" placeholder="此刻的碎碎念..."></textarea>
      <div class="composer-footer">
        <span>字数限制 300</span>
        <button id="publish-btn" class="btn btn-primary" style="padding: 6px 16px; font-size: 13px;">发布</button>
      </div>
    </section>

    <!-- 动态流 -->
    <section class="feed-section">
      <h2 class="section-title">广场动态</h2>
      <div id="feed-container" class="feed-grid"></div>
    </section>
  </main>

  <script>
    import { getFeed, createMoment } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    if (localStorage.getItem('ziji_uid')) {
      document.getElementById('composer')!.style.display = 'block';
    }

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + ' 小时前';
      return Math.floor(hr / 24) + ' 天前';
    }

    async function loadFeed() {
      const el = document.getElementById('feed-container') as HTMLElement;
      try {
        const { moments, articles } = await getFeed(30);
        const all = [
          ...moments.map((m: any) => ({ ...m, _type: 'moment' })),
          ...articles.map((a: any) => ({ ...a, _type: 'article' })),
        ].sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());

        if (all.length === 0) {
          el.innerHTML = '<div class="empty-state">还没有动态，成为第一个发声的人吧。</div>';
          return;
        }

        el.innerHTML = all.map((item: any) => {
          const profile = item.profiles || {};
          const name = sanitizeText(profile.display_name || profile.username || '匿名');
          const avatar = profile.avatar_url;
          return `
            <div class="feed-item card animate-fade-up">
              <div class="feed-header">
                <a href="/${profile.username || '#'}" class="author">
                  ${avatar ? `<img src="${avatar}" class="avatar" />` : `<div class="avatar placeholder">${name.charAt(0)}</div>`}
                  <span class="name">${name}</span>
                </a>
                <span class="time">${fmtTime(item.published_at || item.created_at)}</span>
              </div>
              <div class="feed-body">
                ${item._type === 'article' 
                  ? `<a href="/post/${item.id}" class="article-link"><div class="art-title">${sanitizeText(item.title)}</div><div class="art-summary">${sanitizeText(item.summary || '')}</div></a>`
                  : `<div class="moment-content">${sanitizeText(item.content)}</div>`
                }
              </div>
            </div>
          `;
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty-state" style="color:#ef4444">加载失败: ${e.message}</div>`;
      }
    }

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      const input = document.getElementById('moment-input') as HTMLTextAreaElement;
      if (!uid) return alert('请先登录');
      if (!input.value.trim()) return;

      const btn = document.getElementById('publish-btn') as HTMLButtonElement;
      btn.disabled = true; btn.innerText = '发布中...';
      
      try {
        await createMoment(uid, input.value.trim());
        input.value = '';
        await loadFeed();
      } catch(e: any) { alert('发布失败: ' + e.message); }
      finally { btn.disabled = false; btn.innerText = '发布'; }
    });

    document.addEventListener('DOMContentLoaded', loadFeed);
  </script>

  <style>
    .home-main { max-width: 720px; margin: 0 auto; padding: 64px 20px 100px; }
    
    .hero { text-align: center; margin-bottom: 64px; }
    .hero-badge {
      display: inline-block; padding: 6px 16px; margin-bottom: 24px;
      background: var(--accent-glow); color: var(--accent);
      border-radius: 99px; font-size: 13px; font-weight: 500;
    }
    .hero-title {
      font-size: clamp(36px, 6vw, 56px); line-height: 1.15;
      font-weight: 700; letter-spacing: -0.03em; margin-bottom: 24px;
    }
    .gradient-text {
      background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: 16px; color: var(--text-secondary);
      max-width: 480px; margin: 0 auto 40px; line-height: 1.7;
    }
    .hero-actions { display: flex; justify-content: center; gap: 16px; }
    
    .composer { padding: 20px; margin-bottom: 40px; }
    .composer textarea {
      width: 100%; height: 80px; background: transparent; border: none;
      color: var(--text-primary); font-size: 15px; resize: none; outline: none; font-family: inherit;
    }
    .composer-footer {
      display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid var(--border); padding-top: 16px; margin-top: 8px;
    }
    .composer-footer span { font-size: 12px; color: var(--text-muted); }

    .feed-section { max-width: 640px; margin: 0 auto; }
    .section-title {
      font-size: 14px; color: var(--text-secondary); font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 20px; padding-left: 4px;
    }
    .feed-grid { display: flex; flex-direction: column; gap: 16px; }
    
    .feed-item { padding: 24px; }
    .feed-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .author { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%; object-fit: cover;
      border: 1px solid var(--border);
    }
    .avatar.placeholder {
      display: grid; place-items: center; background: var(--bg-elevated);
      color: var(--text-secondary); font-size: 13px; font-weight: 600;
    }
    .name { font-size: 14px; font-weight: 500; color: var(--text-primary); }
    .time { font-size: 12px; color: var(--text-muted); }
    
    .moment-content {
      font-size: 15px; line-height: 1.7; color: var(--text-secondary); white-space: pre-wrap;
    }
    .article-link { display: block; }
    .art-title { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
    .art-summary { font-size: 14px; color: var(--text-secondary); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    .empty-state { text-align: center; color: var(--text-muted); font-size: 14px; padding: 40px 0; }
  </style>
</Layout>
