---
import Layout from '../layouts/Layout.astro';
---
<Layout title="大厅 · 子骥的小站">
  <div class="home-layout">
    <!-- 左侧：主内容 -->
    <main class="main-col">
      <!-- 欢迎区域，改为社区感 -->
      <section class="hero-section reveal">
        <div class="hero-kicker">ZIJI.STATION</div>
        <h1 class="hero-title">日常的<br/>回声。</h1>
        <p class="hero-sub">在算法的缝隙里，留存一点真实的文字与碎碎念。欢迎来到子骥的小站，这里只有朋友们的日常切片。</p>
      </section>

      <!-- 发帖触发器 (已登录可见) -->
      <div id="post-trigger" class="post-trigger reveal" style="display: none; animation-delay: 0.1s;">
        <div class="trigger-avatar">Q</div>
        <div class="trigger-input">分享你的新鲜事...</div>
        <button class="trigger-btn">发动态</button>
      </div>

      <!-- 发帖弹窗 (Modal) -->
      <div id="post-modal" class="post-modal" hidden>
        <div class="post-modal-overlay"></div>
        <div class="post-modal-content">
          <header class="modal-header">
            <button id="close-modal" class="btn-close">取消</button>
            <span class="modal-title">发动态</span>
            <button id="publish-btn" class="btn-publish">发布</button>
          </header>
          <div class="modal-body">
            <div class="modal-user">
              <div class="trigger-avatar">Q</div>
            </div>
            <div class="modal-input-wrap">
              <textarea id="moment-input" placeholder="分享你的新鲜事..." maxlength="300"></textarea>
              <div id="image-preview-area" class="image-grid"></div>
            </div>
          </div>
          <footer class="modal-footer">
            <label for="image-upload" class="icon-btn" title="添加图片">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </label>
            <input type="file" id="image-upload" accept="image/*" multiple style="display: none;" />
            <span class="char-count" id="char-count">0 / 300</span>
          </footer>
        </div>
      </div>

      <!-- 动态流 -->
      <section class="feed-section reveal" style="animation-delay: 0.2s;">
        <header class="section-header">
          <h2>最近动态</h2>
          <div class="line"></div>
        </header>
        <div id="feed-container" class="feed-list"></div>
      </section>
    </main>

    <!-- 右侧：粘性侧边栏 -->
    <aside class="sidebar-col reveal" style="animation-delay: 0.3s;">
      <div class="side-card sticky">
        <h3>Manifesto</h3>
        <p class="about-text">
          这是一个不对外公开的私有空间。<br/>
          我们拒绝信息流算法，拒绝喧哗。<br/>
          只在这里记录文字、生活，与老友重逢。
        </p>
        
        <div class="side-divider"></div>
        
        <h3>Quick Links</h3>
        <div class="status-list">
          <a href="/dashboard" class="status-item link-item">
            <span>写长文章</span>
            <strong>→</strong>
          </a>
          <a href="/arcade" class="status-item link-item">
            <span>去游戏厅</span>
            <strong>→</strong>
          </a>
        </div>
      </div>
    </aside>
  </div>

  <script>
    import { getFeed, createMoment } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    // 检查是否登录，如果登录了就把“发帖入口”展示出来
    const uid = localStorage.getItem('ziji_uid');
    const userName = localStorage.getItem('ziji_user') || 'U';
    
    if (uid) {
      document.getElementById('post-trigger')!.style.display = 'flex';
      document.querySelectorAll('.trigger-avatar').forEach(el => el.textContent = userName.charAt(0).toUpperCase());
    }

    function fmtTime(s: string) {
      const d = new Date(s);
      const diff = Date.now() - d.getTime();
      // 未来时间（时钟偏差）显示"刚刚"，不出负数
      if (diff < 0) return '刚刚';
      const min = Math.floor(diff / 60000);
      if (min < 1) return '刚刚';
      if (min < 60) return min + ' 分钟前';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + ' 小时前';
      const day = Math.floor(hr / 24);
      if (day < 7) return day + ' 天前';
      return d.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
    }

    async function loadFeed() {
      const el = document.getElementById('feed-container') as HTMLElement;
      try {
        const { moments, articles } = await getFeed(30);
        const all = [
          ...moments.map((m: any) => ({ ...m, _type: 'moment' })),
          ...articles.map((a: any) => ({ ...a, _type: 'article' })),
        ].sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());

        if (all.length === 0) {
          el.innerHTML = '<div class="empty-state">还没有人说话，来发第一条动态打破安静吧。</div>';
          return;
        }

        el.innerHTML = all.map((item: any) => {
          const p = item.profiles || {};
          const name = sanitizeText(p.display_name || p.username || '匿名');
          const initial = name.charAt(0).toUpperCase();
          const isArticle = item._type === 'article';
          return `
            <article class="feed-item">
              <header class="feed-meta">
                <div class="avatar-sm" aria-hidden="true">${initial}</div>
                <div class="meta-text">
                  <a href="/${p.username || '#'}" class="author">${name}</a>
                  <span class="time">${fmtTime(item.published_at || item.created_at)}</span>
                </div>
                ${isArticle ? '<span class="kind">文章</span>' : ''}
              </header>
              <div class="feed-body">
                ${isArticle
                  ? `<a href="/post/${item.id}" class="article-link">${item.cover_url ? `<img class="feed-cover" src="${item.cover_url}" alt="" loading="lazy" />` : ''}<h3>${sanitizeText(item.title)}</h3><p>${sanitizeText(item.summary || '')}</p></a>`
                  : `<p class="moment-text">${sanitizeText(item.content)}</p>${
                      item.images && item.images.length > 0 
                        ? `<div class="moment-images">${item.images.map((img: string) => `<img src="${img}" loading="lazy" />`).join('')}</div>` 
                        : ''
                    }`
                }
              </div>
            </article>
          `;
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty-state" style="color: var(--danger);">加载失败: ${e.message}</div>`;
      }
    }

    // 弹窗控制
    const trigger = document.getElementById('post-trigger');
    const modal = document.getElementById('post-modal');
    const closeBtn = document.getElementById('close-modal');
    const overlay = document.querySelector('.post-modal-overlay');
    const momentInput = document.getElementById('moment-input') as HTMLTextAreaElement;
    const charCount = document.getElementById('char-count');

    const toggleModal = (show: boolean) => {
      if (!modal) return;
      if (show) {
        modal.hidden = false;
        momentInput.focus();
      } else {
        modal.hidden = true;
      }
    };

    trigger?.addEventListener('click', () => toggleModal(true));
    closeBtn?.addEventListener('click', () => toggleModal(false));
    overlay?.addEventListener('click', () => toggleModal(false));
    
    momentInput?.addEventListener('input', () => {
      if (charCount) charCount.textContent = `${momentInput.value.length} / 300`;
    });

    let selectedFiles: File[] = [];
    const imageUploadInput = document.getElementById('image-upload') as HTMLInputElement;
    const previewArea = document.getElementById('image-preview-area') as HTMLElement;
    const uploadModule = await import('../lib/upload');
    const toastModule = await import('../lib/toast');

    imageUploadInput?.addEventListener('change', (e) => {
      const files = Array.from((e.target as HTMLInputElement).files || []);
      if (!files.length) return;
      
      selectedFiles = files.slice(0, 4); // 最多4张
      previewArea.innerHTML = '';
      
      selectedFiles.forEach((file, i) => {
        const url = URL.createObjectURL(file);
        const wrap = document.createElement('div');
        wrap.style.cssText = 'position: relative; width: 64px; height: 64px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border);';
        wrap.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;" />
          <button class="remove-img" data-i="${i}" style="position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,0.5);color:#fff;border:none;font-size:10px;cursor:pointer;display:grid;place-items:center;">✕</button>`;
        previewArea.appendChild(wrap);
      });

      previewArea.querySelectorAll('.remove-img').forEach(btn => {
        btn.addEventListener('click', (ev) => {
          const idx = parseInt((ev.currentTarget as HTMLElement).dataset.i!);
          selectedFiles.splice(idx, 1);
          imageUploadInput.dispatchEvent(new Event('change', { bubbles: true }));
          // 直接重绘
          if (selectedFiles.length === 0) previewArea.innerHTML = '';
          else {
             // 重新构造假事件触发
             const dt = new DataTransfer();
             selectedFiles.forEach(f => dt.items.add(f));
             imageUploadInput.files = dt.files;
             imageUploadInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    });

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      const input = document.getElementById('moment-input') as HTMLTextAreaElement;
      if (!uid || (!input.value.trim() && selectedFiles.length === 0)) return;
      
      const btn = document.getElementById('publish-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = selectedFiles.length > 0 ? '上传中…' : '发布中…';
      
      try {
        const uploadedUrls: string[] = [];
        if (selectedFiles.length > 0) {
          for (const file of selectedFiles) {
            // 注意：如果你还没建 Supabase Storage，这里可能会报错。
            // 用 try/catch 包裹，如果报错，先转成本地 blob url 预览（仅限测试）
            try {
              const url = await uploadModule.uploadImage(file);
              uploadedUrls.push(url);
            } catch (uploadErr: any) {
              console.warn('上传失败，使用本地临时预览:', uploadErr);
              // 本地开发兜底（正式环境需去掉这个兜底）
              uploadedUrls.push(URL.createObjectURL(file));
              if (uploadErr.message.includes('Bucket not found')) {
                 throw new Error('请先在 Supabase 后台创建名为 images 的公开存储桶');
              }
            }
          }
        }
        
        await createMoment(uid, input.value.trim(), uploadedUrls);
        
        input.value = '';
        if (charCount) charCount.textContent = '0 / 300';
        selectedFiles = [];
        imageUploadInput.value = '';
        previewArea.innerHTML = '';
        toggleModal(false);
        await loadFeed();
        toastModule.toastSuccess('发布成功');
      } catch (e: any) {
        toastModule.toastError(e.message);
      } finally { 
        btn.disabled = false; 
        btn.textContent = '发布';
      }
    });

    loadFeed();
    document.addEventListener('astro:page-load', loadFeed);
  </script>

  <style>
    .home-layout {
      max-width: 1100px; margin: 0 auto; padding: 120px 32px 80px;
      display: grid; grid-template-columns: 1fr 340px; gap: 64px; align-items: start;
    }
    
    .hero-section { margin-bottom: 64px; }
    .hero-kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 24px; text-transform: uppercase; }
    .hero-title { font-family: var(--font-serif); font-size: clamp(44px, 5vw, 64px); font-weight: 400; line-height: 1.1; color: var(--text-primary); margin-bottom: 24px; letter-spacing: -0.02em; }
    .hero-sub { font-size: 16px; color: var(--text-secondary); line-height: 1.8; max-width: 480px; }

    /* 触发器 */
    :global(.post-trigger) {
      display: flex; align-items: center; gap: 16px;
      background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 16px 24px; margin-bottom: 32px;
      cursor: text; transition: all 0.2s var(--ease-out);
    }
    :global(.post-trigger):hover { border-color: var(--border-light); box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
    :global(.trigger-avatar) {
      width: 40px; height: 40px; border-radius: 50%; background: var(--bg-elevated); border: 1px solid var(--border);
      display: grid; place-items: center; font-size: 16px; font-weight: 600; color: var(--text-primary); flex-shrink: 0;
    }
    :global(.trigger-input) { flex: 1; color: var(--text-muted); font-size: 15px; }
    :global(.trigger-btn) {
      padding: 8px 20px; background: var(--text-primary); color: var(--bg);
      border-radius: 99px; font-size: 13px; font-weight: 500; border: none; cursor: pointer;
      transition: opacity 0.15s;
    }
    :global(.trigger-btn):hover { opacity: 0.9; }

    /* 弹窗 */
    :global(.post-modal) { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
    :global(.post-modal)[hidden] { display: none; }
    :global(.post-modal)-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); animation: fadeIn 0.2s var(--ease-out); }
    :global(.post-modal)-content {
      position: relative; background: var(--bg-surface); border: 1px solid var(--border);
      border-radius: 24px; width: 100%; max-width: 600px; margin: 20px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.15); display: flex; flex-direction: column;
      animation: slideUp 0.3s var(--ease-out);
    }
    :global(.modal-header) { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--border); }
    :global(.btn-close) { background: transparent; border: none; font-size: 14px; color: var(--text-secondary); cursor: pointer; padding: 6px 12px; border-radius: 99px; transition: background 0.15s; }
    :global(.btn-close):hover { background: var(--bg-elevated); color: var(--text-primary); }
    :global(.modal-title) { font-family: var(--font-serif); font-size: 18px; font-weight: 500; color: var(--text-primary); }
    :global(.btn-publish) { padding: 8px 20px; background: var(--text-primary); color: var(--bg); border: none; border-radius: 99px; font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity 0.15s; }
    :global(.btn-publish):disabled { opacity: 0.5; cursor: not-allowed; }

    :global(.modal-body) { display: flex; gap: 16px; padding: 24px; flex: 1; overflow-y: auto; min-height: 200px; max-height: 50vh; }
    :global(.modal-user) { flex-shrink: 0; }
    :global(.modal-input-wrap) { flex: 1; display: flex; flex-direction: column; }
    :global(.modal-input-wrap) textarea {
      width: 100%; min-height: 120px; background: transparent; border: none;
      color: var(--text-primary); font-size: 16px; resize: none; outline: none; line-height: 1.6;
    }
    :global(.modal-footer) { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-top: 1px solid var(--border); }
    :global(.icon-btn) { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: transparent; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; }
    :global(.icon-btn):hover { background: var(--bg-elevated); color: var(--text-primary); }
    :global(.char-count) { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }

    /* 图片九宫格 */
    :global(.image-grid) { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 12px; }
    :global(.image-grid) > div { position: relative; aspect-ratio: 1; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }
    :global(.image-grid) img { width: 100%; height: 100%; object-fit: cover; }
    :global(.image-grid) .remove-img {
      position: absolute; top: 6px; right: 6px; width: 24px; height: 24px;
      border-radius: 50%; background: rgba(0,0,0,0.6); color: #fff; border: none;
      display: grid; place-items: center; font-size: 12px; cursor: pointer; transition: background 0.15s;
    }
    :global(.image-grid) .remove-img:hover { background: #ef4444; }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(20px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

    .section-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
    .section-header h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 400; color: var(--text-primary); }
    .line { flex: 1; height: 1px; background: var(--border); }

    /* Feed 由 JS 动态生成，需 :global 才能被 scoped 样式命中 */
    .feed-list { display: flex; flex-direction: column; gap: 16px; }
    :global(.feed-item) {
      padding: 28px 32px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      transition: border-color 0.2s;
    }
    :global(.feed-item:hover) { border-color: var(--border-light); }

    :global(.feed-meta) { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    :global(.avatar-sm) {
      width: 36px; height: 36px; flex-shrink: 0;
      border-radius: 50%;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      color: var(--text-primary);
      font-size: 14px; font-weight: 600;
      display: grid; place-items: center;
    }
    :global(.meta-text) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    :global(.author) { font-size: 14px; font-weight: 500; color: var(--text-primary); line-height: 1.3; transition: color 0.15s; }
    :global(.author:hover) { color: var(--text-secondary); }
    :global(.time) { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); line-height: 1.3; }
    :global(.kind) {
      margin-left: auto;
      padding: 2px 8px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
    }

    :global(.feed-body) :global(.moment-text) {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.8;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    :global(.feed-body) :global(.article-link) { display: block; }
    :global(.feed-cover) {
      width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
      border-radius: var(--radius-md); margin-bottom: 16px;
      border: 1px solid var(--border);
    }
    :global(.feed-body) :global(h3) { font-family: var(--font-serif); font-size: 21px; font-weight: 400; color: var(--text-primary); margin-bottom: 8px; line-height: 1.35; overflow-wrap: anywhere; }
    :global(.feed-body) :global(p) { font-size: 15px; color: var(--text-secondary); line-height: 1.7; }
    :global(.empty-state) { font-size: 14px; color: var(--text-muted); padding: 40px 0; text-align: center; }

    /* 右侧侧栏 */
    .sidebar-col { position: sticky; top: 120px; }
    .side-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; }
    .side-card h3 { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 20px; }
    
    .status-list { display: flex; flex-direction: column; gap: 12px; }
    .status-item { display: flex; justify-content: space-between; font-size: 14px; text-decoration: none; color: var(--text-primary); }
    .link-item { padding: 8px 0; border-bottom: 1px solid var(--border); transition: opacity 0.2s; }
    .link-item:hover { opacity: 0.7; }
    .link-item span { color: var(--text-secondary); }
    
    .side-divider { height: 1px; background: var(--border); margin: 28px 0; }
    .about-text { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }

    @media (max-width: 900px) {
      .home-layout { grid-template-columns: 1fr; padding-top: 100px; gap: 48px; }
      .sidebar-col { position: static; order: -1; }
    }
    @media (max-width: 480px) {
      :global(.feed-item) { padding: 20px; }
      :global(.feed-meta) { gap: 10px; margin-bottom: 12px; }
      :global(.avatar-sm) { width: 32px; height: 32px; font-size: 13px; }
    }
  </style>
</Layout>
