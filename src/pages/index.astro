---
import Layout from '../layouts/Layout.astro';
---
<Layout title="大厅 · 子骥的小站">
  <div class="home-layout">
    <!-- 左侧：主内容 -->
    <main class="main-col">
      <!-- 欢迎区域，改为社区感 -->
      <section class="hero-section reveal">
        <div class="hero-kicker">ZIJI.STATION</div>
        <h1 class="hero-title">日常的<br/>回声。</h1>
        <p class="hero-sub">在算法的缝隙里，留存一点真实的文字与碎碎念。欢迎来到子骥的小站，这里只有朋友们的日常切片。</p>
      </section>

      <!-- 发帖区域 (已登录可见) -->
      <section id="composer" class="composer-box reveal" style="display: none; animation-delay: 0.1s;">
        <textarea id="moment-input" placeholder="和朋友们分享点新鲜事..."></textarea>
        <div class="composer-footer">
          <span>不超过 300 字</span>
          <button id="publish-btn" class="btn btn-primary" style="padding: 6px 20px; font-size: 13px;">发布动态</button>
        </div>
      </section>

      <!-- 动态流 -->
      <section class="feed-section reveal" style="animation-delay: 0.2s;">
        <header class="section-header">
          <h2>最近动态</h2>
          <div class="line"></div>
        </header>
        <div id="feed-container" class="feed-list"></div>
      </section>
    </main>

    <!-- 右侧：粘性侧边栏 -->
    <aside class="sidebar-col reveal" style="animation-delay: 0.3s;">
      <div class="side-card sticky">
        <h3>Manifesto</h3>
        <p class="about-text">
          这是一个不对外公开的私有空间。<br/>
          我们拒绝信息流算法，拒绝喧哗。<br/>
          只在这里记录文字、生活，与老友重逢。
        </p>
        
        <div class="side-divider"></div>
        
        <h3>Quick Links</h3>
        <div class="status-list">
          <a href="/dashboard" class="status-item link-item">
            <span>写长文章</span>
            <strong>→</strong>
          </a>
          <a href="/arcade" class="status-item link-item">
            <span>去游戏厅</span>
            <strong>→</strong>
          </a>
        </div>
      </div>
    </aside>
  </div>

  <script>
    import { getFeed, createMoment } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    // 检查是否登录，如果登录了就把“发帖框”展示出来
    if (localStorage.getItem('ziji_uid')) {
      document.getElementById('composer')!.style.display = 'flex';
    }

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      return Math.floor(min / 60) + ' 小时前';
    }

    async function loadFeed() {
      const el = document.getElementById('feed-container') as HTMLElement;
      try {
        const { moments, articles } = await getFeed(30);
        const all = [
          ...moments.map((m: any) => ({ ...m, _type: 'moment' })),
          ...articles.map((a: any) => ({ ...a, _type: 'article' })),
        ].sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());

        if (all.length === 0) {
          el.innerHTML = '<div class="empty-state">还没有人说话，来发第一条动态打破安静吧。</div>';
          return;
        }

        el.innerHTML = all.map((item: any) => {
          const p = item.profiles || {};
          const name = sanitizeText(p.display_name || p.username || '匿名');
          return `
            <article class="feed-item">
              <div class="feed-meta">
                <a href="/${p.username || '#'}" class="author">${name}</a>
                <span class="time">${fmtTime(item.published_at || item.created_at)}</span>
              </div>
              <div class="feed-body">
                ${item._type === 'article' 
                  ? `<a href="/post/${item.id}" class="article-link">${item.cover_url ? `<img class="feed-cover" src="${item.cover_url}" alt="" loading="lazy" />` : ''}<h3>${sanitizeText(item.title)}</h3><p>${sanitizeText(item.summary || '')}</p></a>`
                  : `<p class="moment-text">${sanitizeText(item.content)}</p>`
                }
              </div>
            </article>
          `;
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty-state" style="color: var(--danger);">加载失败: ${e.message}</div>`;
      }
    }

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      const input = document.getElementById('moment-input') as HTMLTextAreaElement;
      if (!uid || !input.value.trim()) return;
      
      const btn = document.getElementById('publish-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = '发布中…';
      try {
        await createMoment(uid, input.value.trim());
        input.value = '';
        await loadFeed();
      } finally { 
        btn.disabled = false; 
        btn.textContent = '发布动态';
      }
    });

    loadFeed();
    document.addEventListener('astro:page-load', loadFeed);
  </script>

  <style>
    .home-layout {
      max-width: 1100px; margin: 0 auto; padding: 120px 32px 80px;
      display: grid; grid-template-columns: 1fr 340px; gap: 64px; align-items: start;
    }
    
    .hero-section { margin-bottom: 64px; }
    .hero-kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 24px; text-transform: uppercase; }
    .hero-title { font-family: var(--font-serif); font-size: clamp(44px, 5vw, 64px); font-weight: 400; line-height: 1.1; color: var(--text-primary); margin-bottom: 24px; letter-spacing: -0.02em; }
    .hero-sub { font-size: 16px; color: var(--text-secondary); line-height: 1.8; max-width: 480px; }

    .composer-box { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 48px; display: flex; flex-direction: column; }
    #moment-input { width: 100%; height: 100px; background: transparent; border: none; color: var(--text-primary); font-size: 16px; resize: none; outline: none; line-height: 1.6; }
    .composer-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 16px; margin-top: 16px; }
    .composer-footer span { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }

    .section-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
    .section-header h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 400; color: var(--text-primary); }
    .line { flex: 1; height: 1px; background: var(--border); }

    .feed-list { display: flex; flex-direction: column; }
    .feed-item { padding: 32px 0; border-bottom: 1px solid var(--border); }
    .feed-item:last-child { border-bottom: none; }
    
    .feed-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .author { font-size: 15px; font-weight: 500; color: var(--text-primary); }
    .time { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
    
    .feed-body .moment-text { font-size: 15px; color: var(--text-secondary); line-height: 1.8; white-space: pre-wrap; }
    .feed-body .article-link { display: block; }
    .feed-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-md); margin-bottom: 16px; border: 1px solid var(--border); }
    .feed-body h3 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--text-primary); margin-bottom: 8px; }
    .feed-body p { font-size: 15px; color: var(--text-secondary); line-height: 1.7; }
    .empty-state { font-size: 14px; color: var(--text-muted); padding: 40px 0; text-align: center; }

    /* 右侧侧栏 */
    .sidebar-col { position: sticky; top: 120px; }
    .side-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; }
    .side-card h3 { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 20px; }
    
    .status-list { display: flex; flex-direction: column; gap: 12px; }
    .status-item { display: flex; justify-content: space-between; font-size: 14px; text-decoration: none; color: var(--text-primary); }
    .link-item { padding: 8px 0; border-bottom: 1px solid var(--border); transition: opacity 0.2s; }
    .link-item:hover { opacity: 0.7; }
    .link-item span { color: var(--text-secondary); }
    
    .side-divider { height: 1px; background: var(--border); margin: 28px 0; }
    .about-text { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }

    @media (max-width: 900px) {
      .home-layout { grid-template-columns: 1fr; padding-top: 100px; gap: 48px; }
      .sidebar-col { position: static; order: -1; }
    }
  </style>
</Layout>
