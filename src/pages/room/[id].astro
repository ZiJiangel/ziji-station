---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import FlightChess from '../../components/game/FlightChess';

const { id } = Astro.params;
if (!id) return Astro.redirect('/arcade');

const { data: room } = await supabase
  .from('game_rooms')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!room) return Astro.redirect('/arcade');

const GAME_NAMES: Record<string, string> = { ludo: '飞行棋', doudizhu: '斗地主', monopoly: '大富翁' };
const gameName = GAME_NAMES[room.game_type] || room.game_type;
---

<Layout title={gameName + ' · 房间'} hideNav={true}>
  <FlightChess client:only="react" roomId={id} initialRoom={room} />
</Layout>
