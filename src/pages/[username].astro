---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getPublicPage } from '../lib/api';

const { username } = Astro.params;
if (!username || !/^[a-z0-9_]{3,20}$/.test(username)) return Astro.redirect('/404');

const result = await getPublicPage(username);
if (!result || !result.page || !result.page.blocks || result.page.blocks.length === 0) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { profile, page } = result;
const displayName = profile.display_name || profile.username;
const bio = profile.bio || '这个人很懒，什么都没写。';
const avatar = profile.avatar_url;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Layout title={displayName + ' 的主页'} hideNav={true}>
  <header class="pub-nav">
    <a href="/" class="btn btn-ghost" style="padding: 6px 16px; font-size: 13px;">← 主站</a>
    <span class="nav-title">{displayName}</span>
  </header>

  <main class="pub-layout">
    <!-- 左侧流式内容 -->
    <div class="pub-main">
      {page.blocks.filter((b: any) => b.visible).map((block: any) => (
        <BlockRenderer block={block} userId={profile.id} />
      ))}
    </div>

    <!-- 右侧粘性侧栏 -->
    <aside class="pub-sidebar">
      <div class="side-card card reveal">
        {avatar 
          ? <img src={avatar} class="side-avatar" alt="avatar" />
          : <div class="side-avatar placeholder">{displayName.charAt(0).toUpperCase()}</div>
        }
        <h2>{displayName}</h2>
        <p class="side-bio">{bio}</p>
        <a href="/editor" class="btn btn-ghost" style="width:100%; margin-top:16px;">编辑我的主页</a>
      </div>

      <!-- 高级质感音乐播放器 -->
      <div class="music-widget card reveal">
        <div class="vinyl-wrap">
          <div class="vinyl">
            <div class="center"></div>
          </div>
        </div>
        <div class="m-info">
          <div class="m-title">Akari Theme</div>
          <div class="m-artist">Unknown Artist</div>
        </div>
        <div class="m-controls">
          <span>⏮</span>
          <span class="play-btn">▶</span>
          <span>⏭</span>
        </div>
      </div>
    </aside>
  </main>
</Layout>

<style>
  .pub-nav {
    position: fixed; top: 0; left: 0; right: 0; height: 64px;
    background: rgba(9, 9, 11, 0.7); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; z-index: 100;
  }
  .nav-title { font-weight: 600; font-size: 15px; color: var(--text-primary); }

  .pub-layout {
    max-width: 1040px; margin: 0 auto; padding: 104px 24px 80px;
    display: grid; grid-template-columns: 1fr 300px; gap: 32px; align-items: start;
  }

  .pub-sidebar { position: sticky; top: 104px; display: flex; flex-direction: column; gap: 24px; }
  .side-card { padding: 32px 24px; text-align: center; }
  .side-avatar {
    width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
    margin: 0 auto 16px; border: 2px solid var(--border);
  }
  .side-avatar.placeholder {
    display: grid; place-items: center; background: var(--bg-elevated);
    color: var(--text-secondary); font-size: 28px; font-weight: 700;
  }
  .side-card h2 { font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
  .side-bio { font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0; }

  /* Music Widget */
  .music-widget { padding: 24px; }
  .vinyl-wrap {
    width: 100%; aspect-ratio: 1; background: var(--bg-base); border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center; margin-bottom: 20px;
    border: 1px solid var(--border); overflow: hidden;
  }
  .vinyl {
    width: 85%; aspect-ratio: 1; border-radius: 50%;
    background: repeating-radial-gradient(#18181b, #18181b 2px, #27272a 3px, #18181b 4px);
    display: flex; align-items: center; justify-content: center;
    animation: spin 4s linear infinite; animation-play-state: paused;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
  }
  .center { width: 32%; aspect-ratio: 1; border-radius: 50%; background: var(--accent); border: 4px solid #000; }
  @keyframes spin { 100% { transform: rotate(360deg); } }
  
  .m-info { text-align: center; margin-bottom: 16px; }
  .m-title { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
  .m-artist { font-size: 12px; color: var(--text-muted); }
  .m-controls { display: flex; justify-content: center; gap: 24px; font-size: 18px; color: var(--text-primary); user-select: none; }
  .play-btn { cursor: pointer; transition: transform 0.1s; }
  .play-btn:active { transform: scale(0.9); }

  @media (max-width: 860px) {
    .pub-layout { grid-template-columns: 1fr; padding-top: 88px; }
    .pub-sidebar { position: static; flex-direction: row; flex-wrap: wrap; }
    .side-card, .music-widget { flex: 1; min-width: 250px; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    gsap.utils.toArray('.reveal').forEach((el: any) => {
      gsap.fromTo(el, 
        { y: 30, opacity: 0 }, 
        { y: 0, opacity: 1, duration: 0.8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 95%" } }
      );
    });

    const vinyl = document.querySelector('.vinyl') as HTMLElement;
    const playBtn = document.querySelector('.play-btn') as HTMLElement;
    let playing = false;
    playBtn?.addEventListener('click', () => {
      playing = !playing;
      playBtn.textContent = playing ? '⏸' : '▶';
      vinyl.style.animationPlayState = playing ? 'running' : 'paused';
    });
  });
</script>
