---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getPublicPage } from '../lib/api';
import type { PageData } from '../lib/blocks';

const { username } = Astro.params;
if (!username || !/^[a-z0-9_]{3,20}$/.test(username)) return Astro.redirect('/404');

const result = await getPublicPage(username);
if (!result || !result.page || !result.page.blocks || result.page.blocks.length === 0) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { profile, page } = result;
const displayName = profile.display_name || profile.username;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Layout title={displayName + ' 的主页'} hideNav={true}>
  <!-- 顶部导航 -->
  <header class="pub-header">
    <a href="/" class="back-link">← 回到主站</a>
    <div class="pub-brand">{displayName}</div>
  </header>

  <div class="pub-layout">
    <!-- 左侧主内容（渲染区块） -->
    <main class="pub-main">
      {page.blocks.filter(b => b.visible).map(block => (
        <BlockRenderer block={block} userId={profile.id} />
      ))}
    </main>

    <!-- 右侧粘性侧边栏 -->
    <aside class="pub-sidebar">
      <div class="sticky-card">
        <h3>关于我</h3>
        <p>{profile.bio || '这个人很神秘，什么都没写。'}</p>
        <div class="side-actions">
          <a href="/" class="btn-outline">主站</a>
          <a href="/editor" class="btn-solid">编辑主页</a>
        </div>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  /* 在这里定义一套有厚度感的暗色主题变量 */
  :root {
    --bg: #09090b;
    --card: #18181b;
    --ink: #fafafa;
    --ink-2: #d4d4d8;
    --muted: #a1a1aa;
    --line-soft: #27272a;
    --accent: #38bdf8;
    --font-round: 'JetBrains Mono', system-ui, sans-serif;
  }
  body {
    background-color: var(--bg);
    background-image: radial-gradient(circle at 15% 50%, rgba(56,189,248,0.03) 0%, transparent 50%),
                      radial-gradient(circle at 85% 30%, rgba(167,139,250,0.03) 0%, transparent 50%);
    background-attachment: fixed;
    color: var(--ink);
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
  }
</style>

<style>
  .pub-header {
    position: fixed; top: 0; left: 0; right: 0; height: 64px;
    background: rgba(9, 9, 11, 0.8); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line-soft);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; z-index: 50;
  }
  .back-link { font-size: 14px; color: var(--muted); text-decoration: none; transition: color 0.2s; }
  .back-link:hover { color: var(--ink); }
  .pub-brand { font-family: var(--font-round); font-weight: 700; font-size: 16px; color: var(--ink); }
  
  .pub-layout {
    max-width: 1100px; margin: 0 auto; padding: 104px 24px 80px;
    display: grid; grid-template-columns: 1fr 300px; gap: 40px; align-items: start;
  }
  
  .pub-sidebar { position: sticky; top: 104px; }
  .sticky-card {
    background: var(--card); border: 1px solid var(--line-soft);
    border-radius: 16px; padding: 24px;
  }
  .sticky-card h3 { font-family: var(--font-round); font-size: 16px; margin: 0 0 12px; color: var(--ink); }
  .sticky-card p { font-size: 14px; line-height: 1.6; color: var(--muted); margin: 0 0 20px; }
  .side-actions { display: flex; flex-direction: column; gap: 10px; }
  .btn-outline, .btn-solid {
    display: block; text-align: center; padding: 10px; border-radius: 8px; font-size: 14px; text-decoration: none; font-weight: 500; transition: all 0.2s;
  }
  .btn-outline { border: 1px solid var(--line-soft); color: var(--ink-2); }
  .btn-outline:hover { background: rgba(255,255,255,0.05); }
  .btn-solid { background: var(--accent); color: #000; border: none; }
  .btn-solid:hover { opacity: 0.9; }

  @media (max-width: 860px) {
    .pub-layout { grid-template-columns: 1fr; padding-top: 88px; }
    .pub-sidebar { position: static; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const blocks = document.querySelectorAll('.reveal');
    
    // 设置初始状态
    gsap.set(blocks, { y: 40, opacity: 0 });
    
    // 依次滑入动画
    blocks.forEach((el, i) => {
      gsap.to(el, {
        y: 0,
        opacity: 1,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 90%",
          toggleActions: "play none none reverse"
        },
        delay: i * 0.1
      });
    });
  });
</script>
