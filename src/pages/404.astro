---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 · 页面不存在">
  <main class="nf">
    <div class="code">404</div>
    <h1>页面不存在</h1>
    <p>你要找的页面可能已被删除，或者从未存在过。</p>
    <a href="/" class="home">返回大厅</a>
  </main>
</Layout>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 96px 20px 40px;
    text-align: center;
  }
  .code {
    font-family: var(--font-serif);
    font-size: clamp(96px, 14vw, 160px);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0.12;
  }
  h1 {
    margin: 16px 0 8px;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    color: var(--text-primary);
  }
  p {
    margin: 0 0 32px;
    color: var(--text-secondary);
    font-size: 14px;
  }
  .home {
    padding: 10px 24px;
    background: var(--text-primary);
    color: var(--bg);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: opacity 0.2s;
  }
  .home:hover { opacity: 0.85; }
  .home:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 3px; }
</style>
