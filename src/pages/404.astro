---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 · 页面不存在">
  <main class="nf">
    <div class="code">404</div>
    <h1>页面不存在</h1>
    <p>你要找的页面可能已被删除，或者从未存在过。</p>
    <a href="/" class="home">返回大厅</a>
  </main>
</Layout>

<style>
  .nf {
    min-height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
  }
  .code {
    font-size: 96px;
    font-weight: 700;
    color: #18d1ff;
    line-height: 1;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  h1 {
    margin: 16px 0 8px;
    font-size: 22px;
    color: #fff;
    font-weight: 500;
  }
  p {
    margin: 0 0 32px;
    color: #666;
    font-size: 14px;
  }
  .home {
    padding: 10px 24px;
    background: #18d1ff;
    color: #000;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: opacity 0.15s;
  }
  .home:hover { opacity: 0.85; }
</style>
