---
import Layout from '../layouts/Layout.astro';
---
<Layout title="设置 · 子骥的小站">
  <div class="settings-layout">
    <main class="main-col reveal">
      <header class="header">
        <h1 class="title">个人设置</h1>
        <p class="sub">修改你在小站展示的头像、昵称和简介。</p>
      </header>

      <section class="editor-box">
        <div class="form-group">
          <label>昵称 / 展示名</label>
          <input id="display_name" type="text" placeholder="你的名字" />
        </div>
        
        <div class="form-group">
          <label>头像链接（URL）</label>
          <input id="avatar_url" type="text" placeholder="https://... (图片地址)" />
        </div>

        <div class="form-group">
          <label>个人简介</label>
          <textarea id="bio" rows={4} placeholder="写点什么介绍自己..."></textarea>
        </div>
        
        <div class="editor-footer">
          <button id="save-btn" class="btn btn-primary">保存修改</button>
        </div>
      </section>

      <section class="editor-box" style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="font-weight: 500; color: var(--text-primary); margin-bottom: 4px;">主页高级自定义</div>
          <div style="font-size: 13px; color: var(--text-secondary);">使用区块编辑器自由拼装你的主页和侧栏。</div>
        </div>
        <a href="/editor" class="btn btn-ghost" style="border-radius: 99px; text-decoration: none; padding: 10px 20px;">进入编辑器</a>
      </section>
    </main>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { toastSuccess, toastError } from '../lib/toast';

    async function loadProfile() {
      const uid = localStorage.getItem('ziji_uid');
      if (!uid) { window.location.href = '/login'; return; }

      const { data } = await supabase.from('profiles').select('*').eq('id', uid).single();
      if (data) {
        (document.getElementById('display_name') as HTMLInputElement).value = data.display_name || '';
        (document.getElementById('avatar_url') as HTMLInputElement).value = data.avatar_url || '';
        (document.getElementById('bio') as HTMLTextAreaElement).value = data.bio || '';
      }
    }

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      if (!uid) return;

      const display_name = (document.getElementById('display_name') as HTMLInputElement).value.trim();
      const avatar_url = (document.getElementById('avatar_url') as HTMLInputElement).value.trim();
      const bio = (document.getElementById('bio') as HTMLTextAreaElement).value.trim();

      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = '保存中…';

      try {
        const { error } = await supabase.from('profiles').update({ display_name, avatar_url, bio }).eq('id', uid);
        if (error) throw error;
        
        // 如果修改了名字，更新 localStorage 里的用户名展示
        if (display_name) {
           // 注意这里只是展示名，真正的 username 是唯一且不可改的
        }
        toastSuccess('保存成功');
      } catch (e: any) {
        toastError('保存失败: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = '保存修改';
      }
    });

    loadProfile();
    document.addEventListener('astro:page-load', loadProfile);
  </script>

  <style>
    /* 容器由 Layout 提供 */
    .header { margin-bottom: 48px; }
    .title { font-family: var(--font-serif); font-size: 48px; font-weight: 400; color: var(--text-primary); margin-bottom: 12px; }
    .sub { font-size: 15px; color: var(--text-secondary); }

    .editor-box { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 40px; display: flex; flex-direction: column; gap: 24px; }
    
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    .form-group label { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    
    input, textarea {
      width: 100%; background: transparent; border: none; border-bottom: 1px solid var(--border-light);
      padding: 12px 0; color: var(--text-primary); font-size: 16px; outline: none; transition: border-color 0.2s;
    }
    input:focus, textarea:focus { border-bottom-color: var(--text-primary); }
    input::placeholder, textarea::placeholder { color: var(--text-muted); }
    textarea { resize: vertical; line-height: 1.6; }

    .editor-footer { display: flex; justify-content: flex-end; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border); }
  </style>
</Layout>
