---
import Layout from '../layouts/Layout.astro';
---
<Layout title="设置 · 子骥的小站" noindex={true}>
  <div class="pagehead">
    <div>
      <h1>设置</h1>
      <p>改称呼、调外观、管理通知。</p>
    </div>
  </div>

  <div class="grid2">
    <div>
      <div class="sect-head" style="margin-top:0"><h2 class="sect-title">个人资料</h2></div>
      <div class="card reveal">
        <div class="field"><label class="fl">昵称</label><input class="f" id="display_name" type="text" placeholder="你的名字"></div>
        <div class="field"><label class="fl">头像链接</label><input class="f" id="avatar_url" type="text" placeholder="https://..."></div>
        <div class="field" style="margin-bottom:16px"><label class="fl">一句话介绍</label><textarea class="f" id="bio" rows="2" placeholder="写点什么..."></textarea></div>
        <button class="btn primary sm" id="save-btn">保存改动</button>
      </div>
    </div>
    <div>
      <div class="sect-head" style="margin-top:0"><h2 class="sect-title">外观</h2></div>
      <div class="card reveal reveal-delay-1">
        <div class="switch-row">
          <div><div class="small">深色模式</div><div class="tiny muted">保护你的眼睛</div></div>
          <button class="switch" data-act="toggle-mode" role="switch" aria-checked="false" aria-label="深色模式"></button>
        </div>
        <div class="switch-row" style="display:block">
          <div class="small" style="margin-bottom:10px">色相</div>
          <div class="hue-row" role="radiogroup" aria-label="色相">
            <button class="hue-chip" data-hue="ink"   role="radio" aria-checked="true"  style="--sw: oklch(0.60 0.15 250)"><span></span>墨蓝</button>
            <button class="hue-chip" data-hue="moss"  role="radio" aria-checked="false" style="--sw: oklch(0.56 0.13 145)"><span></span>苔绿</button>
            <button class="hue-chip" data-hue="ember" role="radio" aria-checked="false" style="--sw: oklch(0.66 0.16 40)"><span></span>陶橙</button>
          </div>
        </div>
      </div>
      <div class="sect-head"><h2 class="sect-title">高级</h2></div>
      <div class="card reveal reveal-delay-2">
        <div class="row between">
          <div><div class="small">主页自定义</div><div class="tiny muted">使用区块编辑器搭建</div></div>
          <a href="/editor" class="btn sm">进入</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { toastSuccess, toastError } from '../lib/toast';

    const modeSwitch = document.querySelector('.switch[data-act="toggle-mode"]') as HTMLButtonElement | null;

    function syncAppearance() {
      const root = document.documentElement;
      const isDark = root.getAttribute('data-mode') === 'dark';
      const curHue = root.getAttribute('data-theme') || 'ink';
      if (modeSwitch) {
        modeSwitch.classList.toggle('on', isDark);
        modeSwitch.setAttribute('aria-checked', isDark ? 'true' : 'false');
      }
      document.querySelectorAll<HTMLButtonElement>('.hue-chip').forEach(el => {
        const on = el.dataset.hue === curHue;
        el.classList.toggle('on', on);
        el.setAttribute('aria-checked', on ? 'true' : 'false');
      });
    }

    function commitAppearance(theme: string, mode: string) {
      const root = document.documentElement;
      root.classList.add('theme-transitioning');
      root.setAttribute('data-theme', theme);
      root.setAttribute('data-mode', mode);
      localStorage.setItem('zj-theme', theme);
      localStorage.setItem('zj-mode', mode);
      syncAppearance();
      clearTimeout((window as any).__zjThemeT);
      (window as any).__zjThemeT = setTimeout(() => root.classList.remove('theme-transitioning'), 380);
    }

    syncAppearance();
    document.addEventListener('astro:page-load', syncAppearance);

    modeSwitch?.addEventListener('click', () => {
      const root = document.documentElement;
      const nextMode = root.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
      commitAppearance(root.getAttribute('data-theme') || 'ink', nextMode);
    });

    document.querySelectorAll<HTMLButtonElement>('.hue-chip').forEach(el => {
      el.addEventListener('click', () => {
        const root = document.documentElement;
        commitAppearance(el.dataset.hue || 'ink', root.getAttribute('data-mode') || 'light');
      });
    });

    async function loadProfile() {
      const uid = localStorage.getItem('ziji_uid');
      if (!uid) { window.location.href = '/login'; return; }
      const { data } = await supabase.from('profiles').select('*').eq('id', uid).single();
      if (data) {
        (document.getElementById('display_name') as HTMLInputElement).value = data.display_name || '';
        (document.getElementById('avatar_url') as HTMLInputElement).value = data.avatar_url || '';
        (document.getElementById('bio') as HTMLTextAreaElement).value = data.bio || '';
      }
    }
    loadProfile();
    document.addEventListener('astro:page-load', loadProfile);

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      if (!uid) return;
      const display_name = (document.getElementById('display_name') as HTMLInputElement).value.trim();
      const avatar_url = (document.getElementById('avatar_url') as HTMLInputElement).value.trim();
      const bio = (document.getElementById('bio') as HTMLTextAreaElement).value.trim();
      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = '保存中…';
      try {
        const { error } = await supabase.from('profiles').update({ display_name, avatar_url, bio }).eq('id', uid);
        if (error) throw error;
        toastSuccess('保存成功');
      } catch (e: any) {
        toastError('保存失败: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = '保存改动';
      }
    });
  </script>

  <style>
    .hue-row { display: flex; gap: 6px; flex-wrap: wrap; }
    .hue-chip {
      display: inline-flex; align-items: center; gap: 7px;
      height: 32px; padding: 0 12px;
      font-size: 12.5px; color: var(--secondary);
      background: transparent; border: 1px solid var(--border);
      border-radius: 99px; cursor: pointer;
      transition: all var(--dur-fast) var(--ease-out);
    }
    .hue-chip:hover { border-color: var(--border-hi); color: var(--primary); }
    .hue-chip span {
      width: 13px; height: 13px; border-radius: 50%;
      background: var(--sw);
      box-shadow: inset 0 0 0 1px oklch(0 0 0 / .08);
      transition: transform var(--dur-base) var(--ease-spring);
    }
    .hue-chip.on {
      border-color: var(--accent);
      color: var(--primary);
      background: var(--elevated);
      font-weight: 600;
    }
    .hue-chip.on span { transform: scale(1.15); }
  </style>
</Layout>
