---
import Layout from '../layouts/Layout.astro';
---
<Layout title="登录 · 子骥的小站">
  <main style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div class="ak-card" style="width: 100%; max-width: 400px; padding: 40px 32px;">
      <h1 style="font-family: var(--font-round); font-size: 24px; color: var(--ink); margin-bottom: 8px; text-align: center;">进入终端</h1>
      <p style="font-size: 13px; color: var(--muted); text-align: center; margin-bottom: 32px;">邀请制 · 你的专属自留地</p>
      
      <form id="login-form" style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <label style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px;">邀请码</label>
          <input type="text" id="invite" placeholder="输入邀请码" required style="width: 100%; padding: 12px; background: var(--paper-2); border: 1px solid var(--line-soft); border-radius: 8px; color: var(--ink); outline: none; font-family: inherit; transition: border 0.2s;" />
        </div>
        <div>
          <label style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px;">用户名</label>
          <input type="text" id="username" placeholder="英文小写，3-20位" pattern="[a-z0-9_]{3,20}" required style="width: 100%; padding: 12px; background: var(--paper-2); border: 1px solid var(--line-soft); border-radius: 8px; color: var(--ink); outline: none; font-family: inherit; transition: border 0.2s;" />
        </div>
        <div>
          <label style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px;">密码</label>
          <input type="password" id="password" placeholder="输入密码（自动注册）" required minlength="6" style="width: 100%; padding: 12px; background: var(--paper-2); border: 1px solid var(--line-soft); border-radius: 8px; color: var(--ink); outline: none; font-family: inherit; transition: border 0.2s;" />
        </div>
        <button type="submit" id="submit-btn" class="ak-btn ak-btn--pri" style="height: 44px; margin-top: 8px;">验证并进入</button>
      </form>
      
      <div id="status" style="margin-top: 20px; font-size: 13px; text-align: center; color: var(--muted); min-height: 20px;"></div>
    </div>
  </main>

  <script>
    import { login } from '../lib/api';
    import { supabase } from '../lib/supabase';

    const INVITE_CODE = 'ZIJI2026';
    const form = document.getElementById('login-form') as HTMLFormElement;
    const statusEl = document.getElementById('status') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    // 动态校验输入框
    document.querySelectorAll('input').forEach(el => {
      el.addEventListener('focus', () => (el as HTMLElement).style.borderColor = 'var(--accent)');
      el.addEventListener('blur', () => (el as HTMLElement).style.borderColor = 'var(--line-soft)');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invite = (document.getElementById('invite') as HTMLInputElement).value.trim();
      const username = (document.getElementById('username') as HTMLInputElement).value.trim().toLowerCase();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      if (invite !== INVITE_CODE) {
        statusEl.textContent = '邀请码错误，请联系管理员获取。';
        statusEl.style.color = '#ef4444';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '正在连接…';
      statusEl.textContent = '';

      try {
        await login(username, password);
        statusEl.textContent = '验证成功，正在进入…';
        statusEl.style.color = 'var(--accent)';
        
        // 查询是否已有主页，进行分流
        const { data: page } = await supabase.from('pages').select('is_public').eq('user_id', localStorage.getItem('ziji_uid')).maybeSingle();
        
        setTimeout(() => {
          if (page && page.is_public) {
            window.location.href = '/' + username;
          } else {
            window.location.href = '/editor';
          }
        }, 500);
      } catch (err: any) {
        statusEl.textContent = err.message;
        statusEl.style.color = '#ef4444';
        submitBtn.disabled = false;
        submitBtn.textContent = '验证并进入';
      }
    });
  </script>
</Layout>
