---
import Layout from '../layouts/Layout.astro';
---
<Layout title="登录 · 子骥的小站" hideNav={true}>
  <div class="auth-container">
    <div class="auth-bg-glow"></div>
    <div class="auth-card">
      <a href="/" class="back-link">← 返回大厅</a>
      
      <div class="auth-header">
        <h1 class="glow-text">进入子骥的小站</h1>
        <p>邀请制 · 沉浸式个人空间</p>
      </div>
      
      <form id="login-form" class="auth-form">
        <div class="input-wrap">
          <input type="text" id="invite" placeholder="邀请码" required value="ZIJI2026" />
          <span class="focus-border"></span>
        </div>
        <div class="input-wrap">
          <input type="text" id="username" placeholder="用户名（小写字母/数字）" pattern="[a-z0-9_]{3,20}" required autocomplete="username" />
          <span class="focus-border"></span>
        </div>
        <div class="input-wrap">
          <input type="password" id="password" placeholder="密码（自动注册/登录）" required minlength="6" autocomplete="current-password" />
          <span class="focus-border"></span>
        </div>
        
        <button type="submit" id="submit-btn" class="submit-btn">
          <span>进入终端</span>
        </button>
      </form>
      
      <div id="status" class="status-msg"></div>
    </div>
  </div>

  <script>
    import { login } from '../lib/api';
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const statusEl = document.getElementById('status') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invite = (document.getElementById('invite') as HTMLInputElement).value.trim();
      const username = (document.getElementById('username') as HTMLInputElement).value.trim().toLowerCase();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      if (invite !== 'ZIJI2026') {
        statusEl.textContent = '邀请码错误';
        statusEl.style.color = '#ef4444';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      statusEl.textContent = '';

      try {
        await login(username, password);
        statusEl.textContent = '验证成功，即将跳转…';
        statusEl.style.color = '#38bdf8';
        
        const { data: page } = await supabase.from('pages').select('is_public').eq('user_id', localStorage.getItem('ziji_uid')).maybeSingle();
        
        setTimeout(() => {
          if (page && page.is_public) window.location.href = '/' + username;
          else window.location.href = '/';
        }, 800);
      } catch (err: any) {
        statusEl.textContent = err.message;
        statusEl.style.color = '#ef4444';
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
      }
    });
  </script>

  <style>
    .auth-container {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    .auth-bg-glow {
      position: absolute; width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(56,189,248,0.15) 0%, transparent 70%);
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      filter: blur(60px); z-index: 0; pointer-events: none;
    }
    .auth-card {
      position: relative; z-index: 1;
      width: 100%; max-width: 420px; padding: 48px 40px;
      background: rgba(18, 18, 20, 0.6);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    }
    .back-link {
      position: absolute; top: 24px; left: 24px;
      color: var(--text-secondary); font-size: 13px; text-decoration: none;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--text-primary); }

    .auth-header { text-align: center; margin-bottom: 40px; }
    .auth-header h1 {
      font-size: 28px; font-weight: 700; margin-bottom: 8px;
      background: linear-gradient(135deg, #fff, #a1a1aa);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .auth-header p { color: var(--text-secondary); font-size: 14px; }

    .auth-form { display: flex; flex-direction: column; gap: 24px; }
    .input-wrap { position: relative; }
    .input-wrap input {
      width: 100%; padding: 16px 20px;
      background: rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px; color: #fff; font-size: 15px;
      outline: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .input-wrap input:focus {
      background: rgba(0,0,0,0.6);
      border-color: rgba(56,189,248,0.5);
      box-shadow: 0 0 0 4px rgba(56,189,248,0.1);
    }
    .input-wrap input::placeholder { color: rgba(255,255,255,0.3); }

    .submit-btn {
      position: relative; overflow: hidden;
      padding: 16px; margin-top: 8px;
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      border: none; border-radius: 12px;
      color: #000; font-weight: 700; font-size: 16px;
      cursor: pointer; transition: all 0.3s;
    }
    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(56,189,248,0.4);
    }
    .submit-btn:disabled { opacity: 0.7; transform: none; cursor: not-allowed; }

    .status-msg { text-align: center; margin-top: 24px; font-size: 14px; min-height: 20px; }
  </style>
</Layout>
