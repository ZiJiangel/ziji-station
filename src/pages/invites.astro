---
import Layout from '../layouts/Layout.astro';
---
<Layout title="邀请 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>邀请</h1>
      <p>生成邀请码，把朋友加进来。</p>
    </div>
  </div>

  <div class="card reveal">
    <div class="row between" style="margin-bottom:8px">
      <div>
        <div style="font-size:15px;font-weight:650">生成一张邀请码</div>
        <div class="tiny muted">一次性，7 天有效。发给朋友后对方用邮箱登录即可。</div>
      </div>
      <button class="btn primary sm" id="gen-btn">+ 生成</button>
    </div>
    
    <div id="invite-result" style="display:none">
      <div class="rule" style="margin:12px 0"></div>
      <div class="row between">
        <div>
          <div class="tiny muted">最新生成的邀请链接</div>
          <div class="code" style="margin-top:3px" id="invite-link"></div>
        </div>
        <button class="btn sm" id="copy-btn">复制链接</button>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { toastSuccess, toastError } from '../lib/toast';

    let latestLink = '';

    function showLink(code: string) {
      latestLink = `${window.location.origin}/login?code=${code}`;
      const resEl = document.getElementById('invite-result');
      const linkEl = document.getElementById('invite-link');
      if (resEl && linkEl) {
        linkEl.textContent = latestLink;
        resEl.style.display = 'block';
      }
    }

    document.getElementById('gen-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('gen-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = '生成中…';

      try {
        const { data: session } = await supabase.auth.getSession();
        if (!session.session) {
          toastError('请先登录');
          window.location.href = '/login';
          return;
        }

        const { data, error } = await supabase.rpc('create_invite_code');
        if (error) throw error;
        if (typeof data !== 'string' || !data) throw new Error('未返回邀请码');

        showLink(data);
        toastSuccess('邀请码已生成，7 天内有效');
      } catch (e: any) {
        toastError(e.message || '生成失败');
      } finally {
        btn.disabled = false;
        btn.innerText = '+ 生成';
      }
    });

    // 事件委托，避免重复绑定
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.id !== 'copy-btn' || !latestLink) return;
      navigator.clipboard.writeText(latestLink)
        .then(() => toastSuccess('邀请链接已复制'))
        .catch(() => toastError('复制失败，请手动选中'));
    });
  </script>
  <style>
    .code {
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 6px 10px;
      background: var(--elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--secondary);
      word-break: break-all;
    }
  </style>
</Layout>