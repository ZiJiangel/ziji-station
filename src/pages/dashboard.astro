---
import Layout from '../layouts/Layout.astro';
---
<Layout title="控制台">
  <main style="min-height: 100vh; background: #111; color: #d2d2d2; font-family: 'JetBrains Mono', monospace; padding: 2rem;">
    <div style="max-width: 800px; margin: 0 auto;">
      <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #333; padding-bottom: 1rem;">
        <h1 style="color: #18d1ff; margin: 0; font-size: 1.5rem;">控制台 / 文章管理</h1>
        <div style="display: flex; gap: 1rem;">
          <a href="/editor" style="color: #999; text-decoration: none;">返回编辑器</a>
          <a href="/" style="color: #999; text-decoration: none;">返回主站</a>
        </div>
      </header>
      <div style="background: #1b1b1b; padding: 2rem; border: 1px solid #333; border-radius: 8px; margin-bottom: 2rem;">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem; color: #ccc;">写新文章</h2>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="text" id="title" placeholder="文章标题" style="width: 100%; padding: 12px; background: #242424; border: 1px solid #444; color: #fff; border-radius: 4px; outline: none;" />
          <textarea id="content" placeholder="在这里写正文..." style="width: 100%; height: 200px; padding: 12px; background: #242424; border: 1px solid #444; color: #fff; border-radius: 4px; outline: none; resize: vertical; line-height: 1.6;"></textarea>
          <button id="save-btn" style="align-self: flex-start; padding: 10px 24px; background: #18d1ff; color: #000; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">发布文章</button>
        </div>
      </div>
      <div style="background: #1b1b1b; padding: 2rem; border: 1px solid #333; border-radius: 8px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem; color: #ccc;">已发布的文章</h2>
        <div id="article-list" style="display: flex; flex-direction: column; gap: 1rem;"></div>
      </div>
    </div>
  </main>
  <script>
    import { api } from '../lib/api';
    
    async function renderArticles() {
      const listEl = document.getElementById('article-list') as HTMLDivElement;
      const { articles } = await api.getFeed();
      
      if (articles.length === 0) {
        listEl.innerHTML = '<div style="color: #666; font-size: 0.9rem;">暂无文章。</div>';
        return;
      }
      listEl.innerHTML = articles.map((a: any) => `
        <div style="padding: 1rem; background: #242424; border: 1px solid #333; border-radius: 4px;">
          <h3 style="margin: 0 0 0.5rem 0; color: #18d1ff; font-size: 1.1rem;">${a.title}</h3>
          <p style="margin: 0; color: #888; font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${a.content}</p>
          <div style="margin-top: 0.5rem; font-size: 0.75rem; color: #666;">${new Date(a.created_at).toLocaleString()}</div>
        </div>
      `).join('');
    }

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const titleInput = document.getElementById('title') as HTMLInputElement;
      const contentInput = document.getElementById('content') as HTMLTextAreaElement;
      const uid = localStorage.getItem('ziji_uid');
      
      if (!titleInput.value.trim() || !contentInput.value.trim()) return alert('标题和正文不能为空');
      if (!uid) return alert('请先登录！');

      await api.createArticle(uid, titleInput.value, contentInput.value);
      titleInput.value = '';
      contentInput.value = '';
      renderArticles();
    });

    document.addEventListener('DOMContentLoaded', renderArticles);
  </script>
</Layout>