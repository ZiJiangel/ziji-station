---
import Layout from '../layouts/Layout.astro';
---
<Layout title="写作 · 子骥的小站" noindex={true}>
  <div class="dash-layout">
    
    <!-- 左侧：创作台 -->
    <main class="main-col reveal">
      <header class="header">
        <div class="dash-tabs">
          <button class="dash-tab active" data-tab="article">写文章</button>
          <button class="dash-tab" data-tab="moment">发动态</button>
        </div>
      </header>

      <!-- 文章编辑器 -->
      <section id="tab-article" class="editor-box">
        <input id="title" type="text" placeholder="文章标题" class="title-input" />
        <input id="summary" type="text" placeholder="一句话摘要（可选）" class="summary-input" />
        <input id="cover" type="url" placeholder="封面图链接（可选，https://…）" class="summary-input" />
        <textarea id="content" placeholder="正文内容，支持 Markdown…" class="content-input"></textarea>
        
        <div class="editor-footer">
          <span>Markdown enabled</span>
          <button id="save-btn" class="btn primary">发布文章</button>
        </div>
      </section>

      <!-- 动态编辑器 -->
      <section id="tab-moment" class="editor-box" style="display: none;">
        <textarea id="moment-input" class="moment-textarea" placeholder="分享你的新鲜事..." maxlength="300"></textarea>
        <div id="moment-preview" class="image-grid"></div>
        
        <div class="editor-footer">
          <div style="display: flex; align-items: center; gap: 16px;">
            <label for="moment-image-upload" class="icon-btn" title="添加图片">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </label>
            <input type="file" id="moment-image-upload" accept="image/*" multiple style="display: none;" />
            <span id="moment-char-count" style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);">0 / 300</span>
          </div>
          <button id="moment-save-btn" class="btn primary">发布动态</button>
        </div>
      </section>
    </main>

    <!-- 右侧：文章归档 -->
    <aside class="sidebar-col reveal" style="animation-delay: 0.2s;">
      <div class="side-card">
        <h3>Archive</h3>
        <div id="article-list" class="article-timeline">
          <div class="loading">加载中…</div>
        </div>
      </div>
    </aside>

  </div>

  <script>
    import { getMyArticles, createArticle, deleteArticle, createMoment } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';
    import { toast, toastSuccess, toastError } from '../lib/toast';
    import { uploadImage } from '../lib/upload';

    async function renderArticles() {
      const uid = localStorage.getItem('ziji_uid');
      const list = document.getElementById('article-list') as HTMLElement;
      if (!uid) {
        list.innerHTML = '<div class="empty">请先登录。</div>';
        return;
      }

      try {
        const mine = await getMyArticles(uid);

        if (mine.length === 0) {
          list.innerHTML = '<div class="empty">还没有发布文章。</div>';
          return;
        }

        list.innerHTML = mine.map((a: any) => `
          <div class="timeline-item">
            <div class="time">${new Date(a.published_at).toLocaleDateString('zh-CN')}</div>
            <div class="content">
              <a href="/post/${a.id}" target="_blank" class="t-title">${sanitizeText(a.title)}</a>
              ${a.cover_url ? `<img class="t-cover" src="${a.cover_url}" alt="" loading="lazy" />` : ''}
              <p>${sanitizeText(a.summary || '')}</p>
              <button type="button" class="t-del" data-id="${a.id}" aria-label="删除文章">删除</button>
            </div>
          </div>
        `).join('');

        list.querySelectorAll('.t-del').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = (e.currentTarget as HTMLElement).dataset.id!;
            const { confirmDialog } = await import('../lib/dialog');
            const okDel = await confirmDialog({
              title: '删除文章',
              message: '删除后不可恢复，确定删除？',
              confirmText: '删除',
              danger: true
            });
            if (!okDel) return;
            try {
              await deleteArticle(id);
              toastSuccess('已删除');
              await renderArticles();
            } catch (err: any) {
              toastError('删除失败: ' + err.message);
            }
          });
        });
      } catch (e: any) {
        list.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const titleEl = document.getElementById('title') as HTMLInputElement;
      const summaryEl = document.getElementById('summary') as HTMLInputElement;
      const contentEl = document.getElementById('content') as HTMLTextAreaElement;
      const coverEl = document.getElementById('cover') as HTMLInputElement;
      const uid = localStorage.getItem('ziji_uid');

      if (!uid) return toast('请先登录', 'info');
      if (!titleEl.value.trim() || !contentEl.value.trim()) return toast('标题和正文不能为空', 'info');

      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = '发布中…';

      try {
        await createArticle(uid, titleEl.value.trim(), contentEl.value.trim(), summaryEl.value.trim(), coverEl.value.trim());
        titleEl.value = ''; summaryEl.value = ''; coverEl.value = ''; contentEl.value = '';
        await renderArticles();
        toastSuccess('文章已发布');
      } catch (e: any) {
        toastError('发布失败: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = '发布文章';
      }
    });

    renderArticles();
    document.addEventListener('astro:page-load', renderArticles);

    // --- Tab 切换逻辑 ---
    function initTabs() {
      const tabs = document.querySelectorAll('.dash-tab');
      const tabArticle = document.getElementById('tab-article');
      const tabMoment = document.getElementById('tab-moment');
      if (!tabs.length || !tabArticle || !tabMoment) return;

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const target = (tab as HTMLElement).dataset.tab;
          if (target === 'article') {
            tabArticle.style.display = 'flex';
            tabMoment.style.display = 'none';
          } else {
            tabArticle.style.display = 'none';
            tabMoment.style.display = 'flex';
          }
        });
      });
    }
    initTabs();
    document.addEventListener('astro:page-load', initTabs);

    // --- 动态发布逻辑 ---
    let selectedFiles: File[] = [];
    const momentUploadInput = document.getElementById('moment-image-upload') as HTMLInputElement;
    const momentPreviewArea = document.getElementById('moment-preview') as HTMLElement;
    const momentInput = document.getElementById('moment-input') as HTMLTextAreaElement;
    const momentCharCount = document.getElementById('moment-char-count');

    function updateMomentBtn() {
      const btn = document.getElementById('moment-save-btn') as HTMLButtonElement;
      if (!btn) return;
      const hasContent = momentInput.value.trim().length > 0 || selectedFiles.length > 0;
      btn.disabled = !hasContent;
    }
    setTimeout(updateMomentBtn, 0);

    momentInput?.addEventListener('input', () => {
      if (momentCharCount) momentCharCount.textContent = `${momentInput.value.length} / 300`;
      updateMomentBtn();
    });

    momentUploadInput?.addEventListener('change', (e) => {
      const files = Array.from((e.target as HTMLInputElement).files || []);
      if (!files.length) return;
      if (files.length > 9) {
        toastError('最多只能发 9 张图');
        selectedFiles = files.slice(0, 9);
      } else {
        selectedFiles = files;
      }
      momentPreviewArea.innerHTML = '';
      
      selectedFiles.forEach((file, i) => {
        const url = URL.createObjectURL(file);
        const wrap = document.createElement('div');
        wrap.innerHTML = `<img src="${url}" />
          <button class="remove-img" data-i="${i}">✕</button>`;
        momentPreviewArea.appendChild(wrap);
      });

      momentPreviewArea.querySelectorAll('.remove-img').forEach(btn => {
        btn.addEventListener('click', (ev) => {
          const idx = parseInt((ev.currentTarget as HTMLElement).dataset.i!);
          selectedFiles.splice(idx, 1);
          if (selectedFiles.length === 0) momentPreviewArea.innerHTML = '';
          else {
             const dt = new DataTransfer();
             selectedFiles.forEach(f => dt.items.add(f));
             momentUploadInput.files = dt.files;
             momentUploadInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
          updateMomentBtn();
        });
      });
      updateMomentBtn();
    });

    document.getElementById('moment-save-btn')?.addEventListener('click', async () => {
      const uid = localStorage.getItem('ziji_uid');
      if (!uid) return toast('请先登录', 'info');
      if (!momentInput.value.trim() && selectedFiles.length === 0) return;
      
      const btn = document.getElementById('moment-save-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = selectedFiles.length > 0 ? '上传中…' : '发布中…';
      
      try {
        const uploadedUrls: string[] = [];
        let uploadFailed = false;
        for (const file of selectedFiles) {
          try {
            const url = await uploadImage(file);
            uploadedUrls.push(url);
          } catch (uploadErr: any) {
            console.warn('图片上传失败，使用本地预览:', uploadErr);
            uploadedUrls.push(URL.createObjectURL(file));
            uploadFailed = true;
          }
        }
        if (uploadFailed) {
          toast('图床未配置，图片仅在当前会话可见', 'info');
        }
        await createMoment(uid, momentInput.value.trim(), uploadedUrls);
        
        momentInput.value = '';
        if (momentCharCount) momentCharCount.textContent = '0 / 300';
        selectedFiles = [];
        momentUploadInput.value = '';
        momentPreviewArea.innerHTML = '';
        updateMomentBtn();
        toastSuccess('动态发布成功');
      } catch (e: any) {
        toastError(e.message);
      } finally { 
        btn.disabled = false; 
        btn.textContent = '发布动态';
        updateMomentBtn();
      }
    });
  </script>

  <style>
    .dash-layout {
      display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: start;
    }

    .header { margin-bottom: 32px; }
    
    .dash-tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--border); padding-bottom: 16px; }
    .dash-tab { background: transparent; border: none; font-size: 18px; font-family: var(--font-serif); color: var(--text-muted); cursor: pointer; padding: 0; transition: color 0.2s; }
    .dash-tab:hover { color: var(--text-secondary); }
    .dash-tab.active { color: var(--text-primary); font-weight: 500; }

    .moment-textarea { width: 100%; height: 200px; background: transparent; border: none; color: var(--text-primary); font-size: 16px; resize: none; outline: none; line-height: 1.6; }

    .editor-box { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; display: flex; flex-direction: column; gap: 16px; }
    
    .title-input { width: 100%; background: transparent; border: none; border-bottom: 1px solid var(--border); padding-bottom: 16px; color: var(--text-primary); font-family: var(--font-serif); font-size: 28px; outline: none; transition: border-color 0.2s; }
    .title-input:focus { border-bottom-color: var(--accent); }
    .title-input::placeholder { color: var(--text-muted); }
    
    .summary-input { width: 100%; background: transparent; border: none; color: var(--text-secondary); font-size: 15px; outline: none; padding: 8px 0; }
    .summary-input::placeholder { color: var(--text-muted); }
    
    .content-input { width: 100%; height: 400px; background: transparent; border: none; color: var(--text-primary); font-family: var(--font-mono); font-size: 14px; line-height: 1.8; resize: vertical; outline: none; margin-top: 16px; }
    .content-input::placeholder { color: var(--text-muted); }

    .editor-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 24px; margin-top: 16px; }
    .editor-footer span { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }

    /* 右侧归档 */
    .sidebar-col { position: sticky; top: 120px; }
    .side-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px 24px; }
    .side-card h3 { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 24px; }
    
    /* 归档由 JS 动态生成，需 :global */
    :global(.article-timeline) { display: flex; flex-direction: column; gap: 20px; position: relative; }
    :global(.article-timeline)::before { content: ""; position: absolute; left: 0; top: 8px; bottom: 0; width: 1px; background: var(--border); }

    :global(.timeline-item) { display: flex; gap: 16px; position: relative; padding-left: 16px; }
    :global(.timeline-item)::before { content: ""; position: absolute; left: -3px; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--border); transition: background 0.2s; }
    :global(.timeline-item):hover::before { background: var(--text-primary); }

    :global(.timeline-item) :global(.time) { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); white-space: nowrap; margin-top: 2px; flex-shrink: 0; }
    :global(.timeline-item) :global(.content) { min-width: 0; flex: 1; }
    :global(.timeline-item) :global(.t-title) { display: block; font-size: 14px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; text-decoration: none; transition: color 0.2s; overflow-wrap: anywhere; }
    :global(.timeline-item) :global(.t-title):hover { color: var(--text-secondary); }
    :global(.timeline-item) :global(.content) :global(p) { font-size: 12px; color: var(--text-secondary); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 0; }
    :global(.t-cover) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 8px; }
    :global(.t-del) { margin-top: 8px; padding: 0; background: none; border: none; font-size: 11px; color: var(--text-muted); cursor: pointer; transition: color 0.15s; }
    :global(.t-del):hover { color: var(--danger); }
    :global(.t-del):focus-visible { outline: 2px solid var(--text-primary); outline-offset: 2px; border-radius: 3px; }

    .loading, .empty { font-size: 13px; color: var(--text-muted); }

    /* 动态图片上传组件 (静态部分) */
    .icon-btn { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: transparent; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; }
    .icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
    .image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 12px; }
    :global(.image-grid > div) { position: relative; aspect-ratio: 1; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }
    :global(.image-grid img) { width: 100%; height: 100%; object-fit: cover; }
    :global(.image-grid .remove-img) { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border-radius: 50%; background: oklch(0 0 0 / .62); color: oklch(1 0 0); border: none; display: grid; place-items: center; font-size: 12px; cursor: pointer; transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); backdrop-filter: blur(4px); }
    :global(.image-grid .remove-img):hover { background: var(--danger); transform: scale(1.08); }
    :global(.image-grid .remove-img):active { transform: scale(0.94); }
    :global(.image-grid > div:only-child) { grid-column: span 3; aspect-ratio: auto; max-height: 300px; }
    :global(.image-grid > div:nth-child(2):nth-last-child(1)) { grid-column: span 2; aspect-ratio: auto; max-height: 300px; }
    :global(.image-grid > div:nth-child(3):nth-last-child(1)) { grid-column: span 1; aspect-ratio: 1; }

    @media (max-width: 900px) {
      .dash-layout { grid-template-columns: 1fr; padding-top: 100px; gap: 40px; }
      .sidebar-col { position: static; order: -1; }
    }
  </style>
</Layout>
