---
import Layout from '../layouts/Layout.astro';
---
<Layout title="控制台 · 内容管理">
  <main class="dash">
    <header class="dash-head">
      <h1>内容管理</h1>
      <div class="links">
        <a href="/editor">返回编辑器</a>
        <a href="/">返回大厅</a>
      </div>
    </header>

    <section class="panel">
      <h2>写新文章</h2>
      <input id="title" type="text" placeholder="文章标题" />
      <textarea id="content" rows={10} placeholder="在这里写正文，支持 Markdown…"></textarea>
      <button id="save-btn">发布文章</button>
    </section>

    <section class="panel">
      <h2>我的文章</h2>
      <div id="article-list"></div>
    </section>
  </main>

  <script>
    import { getFeed, createArticle } from '../lib/api';
    import { sanitizeText, renderMarkdown } from '../lib/sanitize';

    async function renderArticles() {
      const uid = localStorage.getItem('ziji_uid');
      const list = document.getElementById('article-list') as HTMLDivElement;
      if (!uid) {
        list.innerHTML = '<p class="empty">请先登录</p>';
        return;
      }

      const { articles } = await getFeed(50);
      const mine = articles.filter((a: any) => a.user_id === uid);

      if (mine.length === 0) {
        list.innerHTML = '<p class="empty">还没有发布文章</p>';
        return;
      }

      list.innerHTML = mine
        .map((a: any) => `
          <div class="article-card">
            <h3>${sanitizeText(a.title)}</h3>
            <p>${sanitizeText(a.summary || '')}</p>
            <div class="article-meta">${new Date(a.published_at).toLocaleString('zh-CN')}</div>
          </div>
        `)
        .join('');
    }

    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const titleEl = document.getElementById('title') as HTMLInputElement;
      const contentEl = document.getElementById('content') as HTMLTextAreaElement;
      const uid = localStorage.getItem('ziji_uid');

      if (!uid) return alert('请先登录');
      if (!titleEl.value.trim() || !contentEl.value.trim()) return alert('标题和正文不能为空');

      try {
        await createArticle(uid, titleEl.value.trim(), contentEl.value.trim());
        titleEl.value = '';
        contentEl.value = '';
        renderArticles();
      } catch (e: any) {
        alert('发布失败：' + e.message);
      }
    });

    document.addEventListener('DOMContentLoaded', renderArticles);
  </script>

  <style>
    .dash {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 20px 80px;
    }
    .dash-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      padding-bottom: 16px;
      border-bottom: 1px solid #2a2a2a;
    }
    .dash-head h1 { margin: 0; font-size: 22px; color: #18d1ff; }
    .links { display: flex; gap: 16px; }
    .links a { font-size: 13px; color: #888; text-decoration: none; }
    .links a:hover { color: #18d1ff; }
    .panel {
      padding: 24px;
      background: #1b1b1b;
      border: 1px solid #2a2a2a;
      border-radius: 16px;
      margin-bottom: 20px;
    }
    .panel h2 { margin: 0 0 16px; font-size: 14px; color: #888; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }
    #title, #content {
      width: 100%;
      padding: 12px;
      background: #111;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      color: #d2d2d2;
      font-size: 14px;
      outline: none;
      margin-bottom: 12px;
      font-family: inherit;
      line-height: 1.6;
    }
    #title:focus, #content:focus { border-color: #18d1ff; }
    #content { resize: vertical; }
    #save-btn {
      padding: 10px 24px;
      background: #18d1ff;
      color: #000;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
    }
    .article-card {
      padding: 14px;
      background: #111;
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      margin-bottom: 10px;
    }
    .article-card h3 { margin: 0 0 6px; font-size: 15px; color: #fff; }
    .article-card p { margin: 0 0 8px; font-size: 13px; color: #888; }
    .article-meta { font-size: 11px; color: #555; }
    .empty { color: #555; font-size: 13px; }
  </style>
</Layout>
