---
import Layout from '../layouts/Layout.astro';
---
<Layout title="游戏 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>游戏</h1>
      <p>几个不严肃的小游戏，成绩由服务端复核。</p>
    </div>
  </div>

  <div class="sect-head" style="margin-top:0">
    <h2 class="sect-title">单人小游戏</h2>
    <span class="tiny muted">本地游玩 · 纯娱乐</span>
  </div>
  
  <div class="grid2" style="margin-bottom:30px">
    <!-- 反应速度 -->
    <div class="card reveal">
      <div class="sect-head" style="margin-top:0"><h2 class="sect-title">反应速度</h2></div>
      <div class="arena" id="reaction-arena">
        <div>
          <div class="big">点这里开始</div>
          <div class="hint">屏幕变色之后再点，抢跑会被记下来</div>
        </div>
      </div>
    </div>

    <!-- 猜数 -->
    <div class="card reveal reveal-delay-1">
      <div class="sect-head" style="margin-top:0"><h2 class="sect-title">猜数</h2><span class="tiny muted" id="guess-count">1 到 100</span></div>
      <div class="row">
        <input class="f" id="guess-input" type="number" placeholder="输入 1-100 的整数" style="flex:1" />
        <button class="btn primary sm" id="guess-btn">猜</button>
        <button class="btn sm" id="guess-reset">重开</button>
      </div>
      <div style="margin-top:14px;min-height:76px;font-size:12px;color:var(--text-secondary);display:flex;flex-direction:column;gap:4px;" id="guess-log">
        <div>我心里想好了一个数。从 1 到 100，六次机会。</div>
      </div>
    </div>
  </div>

  <div class="sect-head">
    <h2 class="sect-title">多人房间</h2>
  </div>
  
  <div class="game-grid" style="margin-bottom:20px">
    <div class="game-card reveal">
      <div class="row between"><span class="gname">飞行棋</span><span class="tag ready">可玩</span></div>
      <div class="gdesc">2-4 人 · 经典回合制 · 约 15 分钟</div>
      <button class="btn sm create-room-btn" data-game="ludo">去玩</button>
    </div>
    <div class="game-card reveal reveal-delay-1">
      <div class="row between"><span class="gname">斗地主</span><span class="tag ready">可玩</span></div>
      <div class="gdesc">3 人 · 扑克博弈 · 出牌校验</div>
      <button class="btn sm create-room-btn" data-game="doudizhu">去玩</button>
    </div>
    <div class="game-card reveal reveal-delay-2">
      <div class="row between"><span class="gname">大富翁</span><span class="tag">筹备中</span></div>
      <div class="gdesc">2-6 人 · 掷骰模拟 · 地产买卖</div>
      <button class="btn sm" disabled>敬请期待</button>
    </div>
  </div>

  <div class="sect-head">
    <h2 class="sect-title">进行中的对局</h2>
  </div>
  <div class="card" style="padding:2px 8px">
    <table class="tbl">
      <thead><tr><th>游戏</th><th>房主</th><th>状态</th><th>创建时间</th><th>操作</th></tr></thead>
      <tbody id="rooms-tbody">
        <tr><td colspan="5" class="muted" style="text-align:center;padding:20px">加载中…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { getActiveGameRooms, createGameRoom } from '../lib/api';
    import { toast, toastError } from '../lib/toast';

    // --- 反应速度 ---
    const arena = document.getElementById('reaction-arena');
    let reactState = 'idle';
    let reactTimer: any;
    let reactStart = 0;

    arena?.addEventListener('click', () => {
      if (reactState === 'idle') {
        reactState = 'wait';
        arena.className = 'arena';
        arena.innerHTML = '<div><div class="big">等信号…</div><div class="hint">别急，还没到</div></div>';
        const delay = 1200 + Math.random() * 2300;
        reactTimer = setTimeout(() => {
          reactState = 'go';
          arena.className = 'arena go';
          arena.innerHTML = '<div><div class="big">现在！</div><div class="hint">点下去</div></div>';
          reactStart = performance.now();
        }, delay);
      } else if (reactState === 'wait') {
        clearTimeout(reactTimer);
        reactState = 'result';
        arena.className = 'arena result';
        arena.innerHTML = '<div><div class="big" style="color:var(--danger)">抢跑了！</div><div class="hint">再来一次</div></div>';
        setTimeout(() => {
          reactState = 'idle';
          arena.className = 'arena';
          arena.innerHTML = '<div><div class="big">点这里开始</div><div class="hint">屏幕变色之后再点，抢跑会被记下来</div></div>';
        }, 1500);
      } else if (reactState === 'go') {
        const time = Math.round(performance.now() - reactStart);
        reactState = 'result';
        arena.className = 'arena result';
        arena.innerHTML = `<div><div class="hint">这次用了</div><div class="score">${time}<span style="font-size:17px"> ms</span></div><div class="hint" style="margin:6px 0 14px">点一下重新开始</div></div>`;
        setTimeout(() => {
          reactState = 'idle';
          arena.className = 'arena';
          arena.innerHTML = '<div><div class="big">点这里开始</div><div class="hint">屏幕变色之后再点，抢跑会被记下来</div></div>';
        }, 2000);
      }
    });

    // --- 猜数 ---
    let secret = Math.floor(Math.random() * 100) + 1;
    let left = 6;
    let won = false;
    const guessInput = document.getElementById('guess-input') as HTMLInputElement;
    const guessBtn = document.getElementById('guess-btn') as HTMLButtonElement;
    const guessLog = document.getElementById('guess-log');
    const guessCount = document.getElementById('guess-count');
    const guessReset = document.getElementById('guess-reset');

    function renderGuess(msg?: string, isWin = false) {
      if (guessCount) guessCount.textContent = `还剩 ${left} 次`;
      if (msg && guessLog) {
        const el = document.createElement('div');
        el.style.color = isWin ? 'var(--text-primary)' : 'var(--text-secondary)';
        el.style.fontWeight = isWin ? '600' : 'normal';
        el.innerHTML = msg;
        guessLog.prepend(el);
      }
      if (left <= 0 && !won && guessBtn) {
        guessBtn.disabled = true;
      }
    }

    function resetGuess() {
      secret = Math.floor(Math.random() * 100) + 1;
      left = 6; won = false;
      if (guessInput) guessInput.value = '';
      if (guessBtn) guessBtn.disabled = false;
      if (guessLog) guessLog.innerHTML = '<div>我心里想好了一个数。从 1 到 100，六次机会。</div>';
      if (guessCount) guessCount.textContent = '1 到 100';
    }

    guessBtn?.addEventListener('click', () => {
      if (!guessInput || !guessInput.value || won || left <= 0) return;
      const v = parseInt(guessInput.value);
      if (isNaN(v) || v < 1 || v > 100) return;
      left--;
      guessInput.value = '';
      
      if (v === secret) {
        won = true;
        renderGuess(`<b>${v}</b>　猜中了！用了 ${6 - left} 次。`, true);
        if (guessBtn) guessBtn.disabled = true;
      } else if (v < secret) {
        renderGuess(`<b>${v}</b>　小了`);
      } else {
        renderGuess(`<b>${v}</b>　大了`);
      }
      
      if (left <= 0 && !won) {
        renderGuess(`机会用完了，答案是 <b>${secret}</b>。`, true);
      }
    });

    guessReset?.addEventListener('click', resetGuess);

    // --- 房间列表与创建 ---
    const GAME_NAMES: Record<string, string> = { ludo: '飞行棋', doudizhu: '斗地主', monopoly: '大富翁' };

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      return Math.floor(min / 60) + ' 小时前';
    }

    async function loadRooms() {
      const tbody = document.getElementById('rooms-tbody');
      if (!tbody) return;
      try {
        const rooms = await getActiveGameRooms();
        if (!rooms.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="muted" style="text-align:center;padding:20px">当前没有正在进行的对局。</td></tr>';
          return;
        }
        tbody.innerHTML = rooms.map(r => {
          const p = r.profiles || {};
          const name = p.display_name || p.username || '匿名';
          return `
            <tr>
              <td><b>${GAME_NAMES[r.game_type] || r.game_type}</b></td>
              <td>${name}</td>
              <td><span class="tag ${r.status === 'waiting' ? 'ready' : ''}">${r.status === 'waiting' ? '等待中' : '进行中'}</span></td>
              <td class="muted">${fmtTime(r.created_at)}</td>
              <td><a href="/room/${r.id}" class="act">进入 →</a></td>
            </tr>
          `;
        }).join('');
      } catch (e: any) {
        tbody.innerHTML = `<tr><td colspan="5" class="muted" style="text-align:center;color:var(--danger)">加载失败: ${e.message}</td></tr>`;
      }
    }

    loadRooms();
    document.addEventListener('astro:page-load', loadRooms);

    document.querySelectorAll('.create-room-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = localStorage.getItem('ziji_uid');
        if (!uid) return toast('请先登录', 'info');
        const gameType = (btn as HTMLElement).dataset.game;
        if (!gameType) return;
        try {
          (btn as HTMLButtonElement).disabled = true;
          (btn as HTMLButtonElement).textContent = '创建中…';
          const room = await createGameRoom(uid, gameType);
          window.location.href = '/room/' + room.id;
        } catch (e: any) {
          console.error('[createRoom]', e);
          toastError('创建失败: ' + (e.message || String(e)));
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = '去玩';
        }
      });
    });
  </script>
</Layout>
