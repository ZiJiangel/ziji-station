---
import Layout from '../layouts/Layout.astro';
---
<Layout title="游戏厅 · 子骥的小站">
  <div class="arcade-layout">
    <header class="header">
      <h1 class="title reveal">Playground.</h1>
      <p class="sub reveal" style="animation-delay: 0.1s;">放下代码与文字，来一局轻松的回合制游戏。把房间链接发给朋友即可联机。</p>
    </header>

    <div class="game-grid">
      <div class="game-row reveal" style="animation-delay: 0.2s;">
        <div class="g-index">01</div>
        <div class="g-content">
          <h2>飞行棋 / Aeroplane Chess</h2>
          <p>2-4 人 · 经典回合制 · 约 15 分钟</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary">创建房间</button>
          <button class="btn btn-ghost">加入</button>
        </div>
      </div>
      
      <div class="game-row reveal" style="animation-delay: 0.3s;">
        <div class="g-index">02</div>
        <div class="g-content">
          <h2>斗地主 / Dou Dizhu</h2>
          <p>3 人 · 扑克博弈 · 出牌校验</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary">创建房间</button>
          <button class="btn btn-ghost">加入</button>
        </div>
      </div>

      <div class="game-row reveal" style="animation-delay: 0.4s;">
        <div class="g-index">03</div>
        <div class="g-content">
          <h2>大富翁 / Monopoly</h2>
          <p>2-6 人 · 掷骰模拟 · 地产买卖</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary">创建房间</button>
          <button class="btn btn-ghost">加入</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .arcade-layout { max-width: 1000px; margin: 0 auto; padding: 140px 32px 80px; }
  
  .header { margin-bottom: 80px; }
  .title { font-family: var(--font-serif); font-size: 64px; font-weight: 400; color: var(--text-primary); letter-spacing: -0.02em; margin-bottom: 16px; }
  .sub { font-size: 16px; color: var(--text-secondary); max-width: 460px; line-height: 1.7; }

  .game-grid { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .game-row {
    display: flex; align-items: center; gap: 40px;
    padding: 40px 0; border-bottom: 1px solid var(--border);
    transition: all 0.3s;
  }
  .game-row:hover { background: rgba(255,255,255,0.02); padding-left: 16px; padding-right: 16px; border-radius: var(--radius-md); }
  
  .g-index { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); width: 40px; }
  .g-content { flex: 1; }
  .g-content h2 { font-family: var(--font-serif); font-size: 28px; font-weight: 400; color: var(--text-primary); margin-bottom: 8px; }
  .g-content p { font-size: 14px; color: var(--text-secondary); font-family: var(--font-mono); }
  
  .g-actions { display: flex; gap: 12px; }
  
  @media (max-width: 768px) {
    .game-row { flex-direction: column; align-items: flex-start; gap: 24px; padding: 32px 0; }
    .g-index { display: none; }
    .g-actions { width: 100%; }
    .g-actions button { flex: 1; }
  }
</style>
