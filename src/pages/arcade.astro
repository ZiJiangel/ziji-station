---
import Layout from '../layouts/Layout.astro';
---
<Layout title="游戏厅 · 子骥的小站">
  <div class="arcade-layout">
    <header class="header reveal">
      <h1 class="title">Playground.</h1>
      <p class="sub">放下代码与文字，来一局轻松的回合制游戏。把房间链接发给朋友即可联机。</p>
    </header>

    <div class="game-grid">
      <div class="game-row reveal" style="animation-delay: 0.1s;">
        <div class="g-index">01</div>
        <div class="g-content">
          <h2>飞行棋 / Aeroplane Chess</h2>
          <p>2-4 人 · 经典回合制 · 约 15 分钟</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary create-room-btn" data-game="ludo">创建房间</button>
        </div>
      </div>
      
      <div class="game-row reveal" style="animation-delay: 0.2s;">
        <div class="g-index">02</div>
        <div class="g-content">
          <h2>斗地主 / Dou Dizhu</h2>
          <p>3 人 · 扑克博弈 · 出牌校验</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary create-room-btn" data-game="doudizhu">创建房间</button>
        </div>
      </div>

      <div class="game-row reveal" style="animation-delay: 0.3s;">
        <div class="g-index">03</div>
        <div class="g-content">
          <h2>大富翁 / Monopoly</h2>
          <p>2-6 人 · 掷骰模拟 · 地产买卖</p>
        </div>
        <div class="g-actions">
          <button class="btn btn-primary create-room-btn" data-game="monopoly">创建房间</button>
        </div>
      </div>
    </div>

    <!-- 进行中的房间 -->
    <section class="active-rooms reveal" style="animation-delay: 0.4s;">
      <header class="section-header">
        <h2>进行中的对局</h2>
        <div class="line"></div>
      </header>
      <div id="rooms-list" class="room-list">
        <div class="empty">加载中…</div>
      </div>
    </section>
  </div>

  <script>
    import { getActiveGameRooms, createGameRoom } from '../lib/api';
    import { toast, toastError } from '../lib/toast';

    const GAME_NAMES: Record<string, string> = {
      ludo: '飞行棋',
      doudizhu: '斗地主',
      monopoly: '大富翁'
    };

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      return Math.floor(min / 60) + ' 小时前';
    }

    async function loadRooms() {
      const list = document.getElementById('rooms-list');
      if (!list) return;
      try {
        const rooms = await getActiveGameRooms();
        if (!rooms.length) {
          list.innerHTML = '<div class="empty">当前没有正在进行的对局。</div>';
          return;
        }
        list.innerHTML = rooms.map(r => {
          const p = r.profiles || {};
          const name = p.display_name || p.username || '匿名';
          return `
            <a href="/room/${r.id}" class="room-item">
              <div class="room-game">${GAME_NAMES[r.game_type] || r.game_type}</div>
              <div class="room-host">房主：${name}</div>
              <div class="room-status">${r.status === 'waiting' ? '等待中' : '游戏进行中'}</div>
              <div class="room-time">${fmtTime(r.created_at)}</div>
              <div class="room-enter">进入 →</div>
            </a>
          `;
        }).join('');
      } catch (e: any) {
        list.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }

    loadRooms();
    document.addEventListener('astro:page-load', loadRooms);

    document.querySelectorAll('.create-room-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = localStorage.getItem('ziji_uid');
        if (!uid) return toast('请先登录', 'info');
        
        const gameType = (btn as HTMLElement).dataset.game;
        if (!gameType) return;
        
        try {
          (btn as HTMLButtonElement).disabled = true;
          (btn as HTMLButtonElement).textContent = '创建中…';
          const room = await createGameRoom(uid, gameType);
          window.location.href = '/room/' + room.id;
        } catch (e: any) {
          toastError('创建失败: ' + e.message);
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = '创建房间';
        }
      });
    });
  </script>

  <style>
    .arcade-layout { max-width: 1000px; margin: 0 auto; padding: 40px 32px 80px; }
    
    .header { margin-bottom: 64px; }
    .title { font-family: var(--font-serif); font-size: 64px; font-weight: 400; color: var(--text-primary); letter-spacing: -0.02em; margin-bottom: 16px; }
    .sub { font-size: 16px; color: var(--text-secondary); max-width: 460px; line-height: 1.7; }

    .game-grid { display: flex; flex-direction: column; border-top: 1px solid var(--border); margin-bottom: 80px; }
    .game-row {
      display: flex; align-items: center; gap: 40px;
      padding: 40px 0; border-bottom: 1px solid var(--border);
      transition: all 0.3s;
    }
    .game-row:hover { background: var(--bg-surface); padding-left: 16px; padding-right: 16px; border-radius: var(--radius-md); }
    
    .g-index { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); width: 40px; }
    .g-content { flex: 1; }
    .g-content h2 { font-family: var(--font-serif); font-size: 28px; font-weight: 400; color: var(--text-primary); margin-bottom: 8px; }
    .g-content p { font-size: 14px; color: var(--text-secondary); font-family: var(--font-mono); }
    .g-actions { display: flex; gap: 12px; }

    .section-header { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }
    .section-header h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 400; color: var(--text-primary); white-space: nowrap; }
    .line { flex: 1; height: 1px; background: var(--border); }

    .room-list { display: flex; flex-direction: column; gap: 16px; }
    :global(.room-item) {
      display: grid; grid-template-columns: 100px 1fr 100px 100px 60px;
      align-items: center; gap: 16px; padding: 20px 24px;
      background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
      text-decoration: none; color: var(--text-primary); transition: border-color 0.2s;
    }
    :global(.room-item:hover) { border-color: var(--border-light); }
    :global(.room-game) { font-family: var(--font-serif); font-size: 18px; }
    :global(.room-host) { font-size: 14px; color: var(--text-secondary); }
    :global(.room-status) { font-size: 12px; font-family: var(--font-mono); color: var(--text-muted); }
    :global(.room-time) { font-size: 12px; font-family: var(--font-mono); color: var(--text-muted); }
    :global(.room-enter) { font-size: 13px; font-weight: 500; text-align: right; }
    :global(.empty) { font-size: 14px; color: var(--text-muted); padding: 40px 0; text-align: center; }
    
    @media (max-width: 768px) {
      .game-row { flex-direction: column; align-items: flex-start; gap: 24px; padding: 32px 0; }
      .g-index { display: none; }
      .g-actions { width: 100%; }
      .g-actions button { flex: 1; }
      :global(.room-item) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
      :global(.room-enter) { align-self: flex-end; margin-top: -24px; }
    }
  </style>
</Layout>
