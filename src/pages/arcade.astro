---
import Layout from '../layouts/Layout.astro';
---
<Layout title="游戏厅">
  <main style="max-width: 900px; margin: 0 auto; padding: 40px 24px;">
    <div style="margin-bottom: 40px;">
      <h1 style="font-size: 28px; color: #18d1ff; margin: 0 0 12px 0;">游戏厅</h1>
      <p style="color: #888; font-size: 14px; line-height: 1.6; max-width: 500px;">
        回合制联机小游戏。创建房间后，把链接发给你的朋友，即可一起游玩。
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px;">
      <!-- 飞行棋 -->
      <div style="background: #1b1b1b; border: 1px solid #333; border-radius: 16px; overflow: hidden; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='#18d1ff';" onmouseout="this.style.transform='translateY(0)';this.style.borderColor='#333';">
        <div style="height: 120px; background: linear-gradient(135deg, #242424 0%, #111 100%); display: grid; place-items: center; color: #18d1ff;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
        </div>
        <div style="padding: 20px;">
          <h3 style="margin: 0 0 8px 0; color: #fff; font-size: 18px;">飞行棋</h2>
          <p style="color: #666; font-size: 13px; margin: 0 0 16px 0;">2-4 人 · 回合制 · 约 15 分钟</p>
          <div style="display: flex; gap: 8px;">
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: #18d1ff; color: #000; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">创建房间</button>
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: transparent; color: #18d1ff; border: 1px solid #18d1ff; border-radius: 8px; font-weight: bold; cursor: pointer;">加入</button>
          </div>
        </div>
      </div>

      <!-- 斗地主 -->
      <div style="background: #1b1b1b; border: 1px solid #333; border-radius: 16px; overflow: hidden; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='#18d1ff';" onmouseout="this.style.transform='translateY(0)';this.style.borderColor='#333';">
        <div style="height: 120px; background: linear-gradient(135deg, #242424 0%, #111 100%); display: grid; place-items: center; color: #18d1ff;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="14" height="16" rx="2"/><path d="M17 9h4v12H7"/></svg>
        </div>
        <div style="padding: 20px;">
          <h3 style="margin: 0 0 8px 0; color: #fff; font-size: 18px;">斗地主</h3>
          <p style="color: #666; font-size: 13px; margin: 0 0 16px 0;">3 人 · 扑克 · 出牌校验</p>
          <div style="display: flex; gap: 8px;">
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: #18d1ff; color: #000; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">创建房间</button>
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: transparent; color: #18d1ff; border: 1px solid #18d1ff; border-radius: 8px; font-weight: bold; cursor: pointer;">加入</button>
          </div>
        </div>
      </div>

      <!-- 大富翁 -->
      <div style="background: #1b1b1b; border: 1px solid #333; border-radius: 16px; overflow: hidden; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='#18d1ff';" onmouseout="this.style.transform='translateY(0)';this.style.borderColor='#333';">
        <div style="height: 120px; background: linear-gradient(135deg, #242424 0%, #111 100%); display: grid; place-items: center; color: #18d1ff;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>
        </div>
        <div style="padding: 20px;">
          <h3 style="margin: 0 0 8px 0; color: #fff; font-size: 18px;">大富翁</h3>
          <p style="color: #666; font-size: 13px; margin: 0 0 16px 0;">2-6 人 · 掷骰 · 地产买卖</p>
          <div style="display: flex; gap: 8px;">
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: #18d1ff; color: #000; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">创建房间</button>
            <button onclick="alert('联机逻辑开发中，敬请期待！')" style="flex: 1; padding: 8px; background: transparent; color: #18d1ff; border: 1px solid #18d1ff; border-radius: 8px; font-weight: bold; cursor: pointer;">加入</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>