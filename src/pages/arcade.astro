---
import Layout from '../layouts/Layout.astro';
---
<Layout title="游戏 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>游戏</h1>
      <p>几个不严肃的小游戏，成绩由服务端复核。</p>
    </div>
  </div>

  <div class="game-grid" style="margin-bottom:20px">
    <div class="game-card">
      <div class="row between"><span class="gname">飞行棋</span><span class="tag ready">可玩</span></div>
      <div class="gdesc">2-4 人 · 经典回合制 · 约 15 分钟</div>
      <button class="btn sm create-room-btn" data-game="ludo">去玩</button>
    </div>
    <div class="game-card">
      <div class="row between"><span class="gname">斗地主</span><span class="tag ready">可玩</span></div>
      <div class="gdesc">3 人 · 扑克博弈 · 出牌校验</div>
      <button class="btn sm create-room-btn" data-game="doudizhu">去玩</button>
    </div>
    <div class="game-card">
      <div class="row between"><span class="gname">大富翁</span><span class="tag">筹备中</span></div>
      <div class="gdesc">2-6 人 · 掷骰模拟 · 地产买卖</div>
      <button class="btn sm create-room-btn" data-game="monopoly">去玩</button>
    </div>
  </div>

  <div class="sect-head">
    <h2 class="sect-title">进行中的对局</h2>
  </div>
  <div class="card" style="padding:2px 8px">
    <table class="tbl">
      <thead><tr><th>游戏</th><th>房主</th><th>状态</th><th>创建时间</th><th>操作</th></tr></thead>
      <tbody id="rooms-tbody">
        <tr><td colspan="5" class="muted" style="text-align:center;padding:20px">加载中…</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { getActiveGameRooms, createGameRoom } from '../lib/api';
    import { toast, toastError } from '../lib/toast';

    const GAME_NAMES: Record<string, string> = { ludo: '飞行棋', doudizhu: '斗地主', monopoly: '大富翁' };

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      const min = Math.floor(diff / 60000);
      if (min < 60) return min + ' 分钟前';
      return Math.floor(min / 60) + ' 小时前';
    }

    async function loadRooms() {
      const tbody = document.getElementById('rooms-tbody');
      if (!tbody) return;
      try {
        const rooms = await getActiveGameRooms();
        if (!rooms.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="muted" style="text-align:center;padding:20px">当前没有正在进行的对局。</td></tr>';
          return;
        }
        tbody.innerHTML = rooms.map(r => {
          const p = r.profiles || {};
          const name = p.display_name || p.username || '匿名';
          return `
            <tr>
              <td><b>${GAME_NAMES[r.game_type] || r.game_type}</b></td>
              <td>${name}</td>
              <td><span class="tag ${r.status === 'waiting' ? 'ready' : ''}">${r.status === 'waiting' ? '等待中' : '进行中'}</span></td>
              <td class="muted">${fmtTime(r.created_at)}</td>
              <td><a href="/room/${r.id}" class="act">进入 →</a></td>
            </tr>
          `;
        }).join('');
      } catch (e: any) {
        tbody.innerHTML = `<tr><td colspan="5" class="muted" style="text-align:center;color:var(--danger)">加载失败: ${e.message}</td></tr>`;
      }
    }

    loadRooms();
    document.addEventListener('astro:page-load', loadRooms);

    document.querySelectorAll('.create-room-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const uid = localStorage.getItem('ziji_uid');
        if (!uid) return toast('请先登录', 'info');
        const gameType = (btn as HTMLElement).dataset.game;
        if (!gameType) return;
        try {
          (btn as HTMLButtonElement).disabled = true;
          (btn as HTMLButtonElement).textContent = '创建中…';
          const room = await createGameRoom(uid, gameType);
          window.location.href = '/room/' + room.id;
        } catch (e: any) {
          toastError('创建失败: ' + e.message);
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = '去玩';
        }
      });
    });
  </script>
</Layout>
