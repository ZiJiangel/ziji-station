---
import Layout from '../layouts/Layout.astro';
---
<Layout title="相册 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>相册</h1>
      <p>一起拍过的、拍糊了的、当时没在意现在很想再看一眼的。</p>
    </div>
  </div>

  <div class="gallery reveal" id="gallery-grid">
    <div class="empty" style="grid-column: 1 / -1;">加载中…</div>
  </div>

  <script>
    import { getFeed } from '../lib/api';

    async function loadGallery() {
      const el = document.getElementById('gallery-grid');
      if (!el) return;
      try {
        const { moments } = await getFeed(100);
        const allImages = moments.flatMap(m => m.images || []);
        
        if (allImages.length === 0) {
          el.innerHTML = '<div class="empty" style="grid-column: 1 / -1;">还没有人发过照片。</div>';
          return;
        }
        
        el.innerHTML = allImages.map(url => `
          <div class="ph" data-url="${url}">
            <img src="${url}" loading="lazy" />
          </div>
        `).join('');

        el.querySelectorAll('.ph').forEach(p => {
          p.addEventListener('click', () => {
            const url = (p as HTMLElement).dataset.url;
            if (!url) return;
            let box = document.getElementById('lightbox');
            if (!box) {
              box = document.createElement('div');
              box.id = 'lightbox';
              box.className = 'lightbox';
              box.innerHTML = '<img class="lightbox-img" alt="" />';
              document.body.appendChild(box);

              box.addEventListener('click', () => {
                box!.classList.remove('open');
                setTimeout(() => box!.remove(), 220);
              });
              document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') { box!.classList.remove('open'); setTimeout(() => box!.remove(), 220); }
              });
            }
            (box.querySelector('img') as HTMLImageElement).src = url;
            requestAnimationFrame(() => box!.classList.add('open'));
          });
        });
      } catch (e) {
        el.innerHTML = '<div class="empty" style="grid-column: 1 / -1;">加载失败</div>';
      }
    }
    loadGallery();
    document.addEventListener('astro:page-load', loadGallery);
  </script>
  <style>
    .lightbox {
      position: fixed; inset: 0; z-index: 999;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
      background: oklch(0 0 0 / .86);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      cursor: zoom-out;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-out);
    }
    .lightbox.open { opacity: 1; }
    .lightbox-img {
      max-width: 100%; max-height: 100%;
      border-radius: var(--radius-md);
      box-shadow: 0 20px 60px oklch(0 0 0 / .55);
      transform: scale(.96);
      transition: transform var(--dur-slow) var(--ease-spring);
    }
    .lightbox.open .lightbox-img { transform: scale(1); }
    @media (prefers-reduced-motion: reduce) {
      .lightbox, .lightbox-img { transition: none; }
    }
  </style>
</Layout>
