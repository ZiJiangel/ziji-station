---
import Layout from '../layouts/Layout.astro';
---
<Layout title="相册 · 子骥的小站">
  <header class="page-header">
    <h1 class="page-title">相册</h1>
    <p class="page-sub">一起拍过的、拍糊了的、当时没在意现在很想再看一眼的。</p>
  </header>
  <div id="gallery-grid" class="gallery">
    <div class="empty">加载中…</div>
  </div>

  <script>
    import { getFeed } from '../lib/api';

    async function loadGallery() {
      const el = document.getElementById('gallery-grid');
      if (!el) return;
      try {
        const { moments } = await getFeed(100);
        const allImages = moments.flatMap(m => m.images || []);
        
        if (allImages.length === 0) {
          el.innerHTML = '<div class="empty">还没有人发过照片。</div>';
          return;
        }
        
        el.innerHTML = allImages.map(url => `
          <div class="photo">
            <img src="${url}" loading="lazy" />
          </div>
        `).join('');
      } catch (e) {
        el.innerHTML = '<div class="empty">加载失败</div>';
      }
    }
    loadGallery();
    document.addEventListener('astro:page-load', loadGallery);
  </script>
</Layout>

<style>
  .page-header { margin-bottom: 22px; }
  .page-title { font-size: 23px; font-weight: 700; margin: 0 0 5px; }
  .page-sub { font-size: 12.5px; color: var(--text-secondary); margin: 0; }
  
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  :global(.photo) { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: var(--radius-sm); background: var(--bg-surface); border: 1px solid var(--border); cursor: zoom-in; }
  :global(.photo img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.3, 1); }
  :global(.photo:hover img) { transform: scale(1.04); }
  :global(.empty) { grid-column: 1 / -1; padding: 40px; text-align: center; color: var(--text-muted); border: 1px dashed var(--border); border-radius: var(--radius-md); }
  
  @media (max-width: 760px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
  }
</style>
