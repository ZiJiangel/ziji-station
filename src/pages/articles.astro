---
import Layout from '../layouts/Layout.astro';
---
<Layout title="文章 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>文章</h1>
      <p>写得长一点的那些。慢慢写，慢慢读。</p>
    </div>
  </div>

  <div class="wrap" style="margin-bottom:14px">
    <button class="chip on">全部</button>
    <button class="chip">随笔</button>
    <button class="chip">技术</button>
    <button class="chip">游记</button>
  </div>

  <div id="article-list" class="list">
    <div class="empty">加载中…</div>
  </div>

  <script>
    import { getFeed } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    function fmtDate(s: string) {
      return new Date(s).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
    }

    async function loadArticles() {
      const el = document.getElementById('article-list');
      if (!el) return;
      try {
        const { articles } = await getFeed(50);
        if (articles.length === 0) {
          el.innerHTML = '<div class="empty"><span class="big">这个分类还空着</span>去写作台写一篇吧。</div>';
          return;
        }
        el.innerHTML = articles.map(a => {
          const p = a.profiles || {};
          const name = sanitizeText(p.display_name || p.username || '匿名');
          return `
            <div class="li">
              <div class="li-body">
                <a href="/post/${a.id}" class="li-title">${sanitizeText(a.title)}</a>
                <p class="li-excerpt">${sanitizeText(a.summary || '')}</p>
                <div class="li-meta">
                  <span>${name}</span><span>·</span><span>${fmtDate(a.published_at)}</span>
                </div>
              </div>
              ${a.cover_url ? `<div class="li-side"><img src="${a.cover_url}" style="width:100%;height:100%;object-fit:cover;"/></div>` : ''}
            </div>
          `;
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }
    loadArticles();
    document.addEventListener('astro:page-load', loadArticles);
  </script>
</Layout>
