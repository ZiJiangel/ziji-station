---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { getComments } from '../../lib/api';
import { renderMarkdown, sanitizeText } from '../../lib/sanitize';

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

const { data: article } = await supabase
  .from('articles')
  .select('id, title, content, summary, cover_url, published_at, user_id, profiles(username, display_name, avatar_url)')
  .eq('id', id)
  .eq('is_public', true)
  .maybeSingle();

if (!article) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const profile = (article as any).profiles || {};
const authorName = profile.display_name || profile.username || '匿名';
const html = renderMarkdown(article.content);
const dateStr = new Date(article.published_at).toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// 获取留言数据
const comments = await getComments(id);

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Layout title={sanitizeText(article.title)} description={sanitizeText(article.summary || '')}>
  <article class="post">
    <header class="post-head">
      <h1>{sanitizeText(article.title)}</h1>
      <div class="meta">
        <a href={"/" + profile.username} class="author">{sanitizeText(authorName)}</a>
        <span class="dot">·</span>
        <time>{dateStr}</time>
      </div>
    </header>
    {(article as any).cover_url && (
      <img class="cover" src={(article as any).cover_url} alt="" loading="lazy" />
    )}
    <div class="content" set:html={html} />
    <section class="comments">
      <h2 style="font-family: var(--font-sans); font-size: 20px; font-weight: 500; color: var(--text-primary); margin-bottom: 24px;">留言板</h2>
      
      <div id="comment-list" style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px;">
        {comments.length === 0 ? (
          <p style="color: var(--text-muted); font-size: 14px;">还没有留言，来抢个沙发吧。</p>
        ) : (
          comments.map(c => {
            const p = c.profiles || {};
            const name = p.display_name || p.username || '匿名';
            return (
              <div class="comment-item">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-weight: 500; color: var(--text-primary); font-size: 13px;">{name}</span>
                  <span style="font-family: var(--font-mono); color: var(--text-muted); font-size: 11px;">{new Date(c.created_at).toLocaleString('zh-CN')}</span>
                </div>
                <div style="font-size: 14px; color: var(--text-secondary); white-space: pre-wrap;">{c.content}</div>
              </div>
            );
          })
        )}
      </div>

      <div class="comment-box" id="comment-box" style="display: none;">
        <textarea id="comment-input" placeholder="留下你的足迹..."></textarea>
        <div class="comment-foot">
          <span>理智发言，友善交流</span>
          <button id="submit-comment" class="btn btn-primary">发送留言</button>
        </div>
      </div>
    </section>

    <footer class="post-foot">
      <a href="/" class="back">← 返回大厅</a>
    </footer>
  </article>
</Layout>

<script>
  import { createComment } from '../../lib/api';
  import { toast, toastError } from '../../lib/toast';

  const box = document.getElementById('comment-box') as HTMLElement;
  const uid = localStorage.getItem('ziji_uid');

  if (uid) box.style.display = 'block';

  document.getElementById('submit-comment')?.addEventListener('click', async () => {
    const input = document.getElementById('comment-input') as HTMLTextAreaElement;
    const content = input.value.trim();
    if (!uid) return toast('请先登录', 'info');
    if (!content) return;

    try {
      await createComment(uid, window.location.pathname.split('/').pop()!, content);
      input.value = '';
      window.location.reload();
    } catch (e: any) {
      toastError('留言失败: ' + e.message);
    }
  });
</script>

<style>
  .post {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 20px 96px;
  }
  .post-head {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .post-head h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1.3;
    color: var(--text-primary);
    font-weight: 400;
    word-break: break-word;
  }
  .cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-md); margin-bottom: 32px; border: 1px solid var(--border); }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .author {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .author:hover { text-decoration: underline; }
  .content {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--text-secondary);
    word-break: break-word;
  }
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin: 1.6em 0 0.7em;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .content :global(h1) { font-size: 28px; }
  .content :global(h2) { font-size: 22px; }
  .content :global(h3) { font-size: 18px; }
  .content :global(p) { margin: 0 0 1.3em; }
  .content :global(a) { color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px; }
  .content :global(code) {
    padding: 2px 6px;
    background: var(--bg-elevated);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-primary);
  }
  .content :global(pre) {
    padding: 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 0 0 1.3em;
  }
  .content :global(pre code) { padding: 0; background: none; color: var(--text-secondary); }
  .content :global(blockquote) {
    margin: 0 0 1.3em;
    padding-left: 16px;
    border-left: 3px solid var(--border-light);
    color: var(--text-muted);
  }
  .content :global(img) { max-width: 100%; border-radius: var(--radius-sm); }
  .content :global(ul),
  .content :global(ol) { margin: 0 0 1.3em; padding-left: 1.6em; }
  .content :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2em 0; }
  .comments {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .comments h2 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  .comment-item {
    padding: 16px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .comment-box {
    padding: 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .comment-box textarea {
    width: 100%;
    height: 80px;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-primary);
  }
  .comment-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 12px;
    margin-top: 8px;
  }
  .comment-foot span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  #comment-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }
  .post-foot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .back {
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--text-primary); }
  @media (max-width: 640px) {
    .post { padding: 32px 16px 64px; }
    .post-head h1 { font-size: 24px; }
  }
</style>
