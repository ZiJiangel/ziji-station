---
import Layout from '../layouts/Layout.astro';
---
<Layout title="动态 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>动态</h1>
      <p>一句话也算数，想到什么就丢上来。</p>
    </div>
  </div>

  <div class="sect-head">
    <h2 class="sect-title">最近动态</h2>
    <span class="tiny muted" id="moment-count">加载中…</span>
  </div>

  <div id="moment-list" class="list">
    <div class="empty">加载中…</div>
  </div>

  <script>
    import { getFeed } from '../lib/api';
    import { sanitizeText } from '../lib/sanitize';

    function fmtTime(s: string) {
      const d = new Date(s); const diff = Date.now() - d.getTime();
      if (diff < 0) return '刚刚';
      const min = Math.floor(diff / 60000);
      if (min < 1) return '刚刚';
      if (min < 60) return min + ' 分钟前';
      const hr = Math.floor(min / 60);
      if (hr < 24) return hr + ' 小时前';
      const day = Math.floor(hr / 24);
      if (day < 7) return day + ' 天前';
      return d.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
    }

    async function loadMoments() {
      const el = document.getElementById('moment-list');
      const countEl = document.getElementById('moment-count');
      if (!el) return;
      try {
        const { moments } = await getFeed(50);
        if (countEl) countEl.textContent = `${moments.length} 条`;

        if (moments.length === 0) {
          el.innerHTML = '<div class="empty"><span class="big">一句都还没有</span>去写作台发第一条吧。</div>';
          return;
        }
        el.innerHTML = moments.map(m => {
          const p = m.profiles || {};
          const name = sanitizeText(p.display_name || p.username || '匿名');
          const initial = name.charAt(0).toUpperCase();
          return `
            <div class="moment">
              <div class="moment-head">
                <div class="avatar-sm">${initial}</div>
                <a href="/${p.username || '#'}" class="moment-name">${name}</a>
                <span class="moment-time">${fmtTime(m.created_at)}</span>
              </div>
              <p class="moment-text">${sanitizeText(m.content)}</p>
              ${m.images && m.images.length > 0 
                ? `<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px;">${m.images.map((img: string) => `<div style="aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border-light);"><img src="${img}" style="width:100%;height:100%;object-fit:cover;" loading="lazy"/></div>`).join('')}</div>` 
                : ''
              }
            </div>
          `;
        }).join('');
      } catch (e: any) {
        el.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }
    loadMoments();
    document.addEventListener('astro:page-load', loadMoments);
  </script>
</Layout>
