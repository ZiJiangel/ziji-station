---
import Layout from '../layouts/Layout.astro';
---
<Layout title="成员 · 子骥的小站">
  <div class="pagehead">
    <div>
      <h1>成员</h1>
      <p>能进这个站的就这几位。</p>
    </div>
  </div>

  <div id="members-content" class="reveal">
    <div class="empty">加载中…</div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    async function loadMembers() {
      const el = document.getElementById('members-content');
      if (!el) return;

      try {
        const { data: users, error } = await supabase
          .from('profiles')
          .select('*')
          .order('created_at', { ascending: true });

        if (error) throw error;

        if (!users || users.length === 0) {
          el.innerHTML = '<div class="empty">还没有成员记录。</div>';
          return;
        }

        // 围绕当前主题色相派生：固定色相偏移 + 亮度梯度，随主题自动协调
        const baseHue = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--hue')
        ) || 250;
        const hues = [0, 45, 90, 160, 200, 260, 315];
        const colors = hues.map((offset, i) =>
          `oklch(${i % 2 === 0 ? 0.55 : 0.68} 0.10 ${(baseHue + offset) % 360})`
        );

        el.innerHTML = `
          <div class="stat-row">
            <div class="stat"><div class="v">${users.length}</div><div class="k">当前成员</div></div>
            <div class="stat"><div class="v">${users.length}</div><div class="k">累计入驻</div></div>
            <div class="stat"><div class="v">—</div><div class="k">一起写过的文章</div></div>
            <div class="stat"><div class="v">—</div><div class="k">一起存的照片</div></div>
          </div>
          <div class="card" style="padding:2px 18px">
            <div class="people">
              ${users.map((u, i) => `
                <div class="person" style="--i:${i}">
                  <div class="avatar-sm" style="width:46px;height:46px;font-size:18px;background:${colors[i % colors.length]};color:oklch(0.99 0 0)">${u.username.charAt(0).toUpperCase()}</div>
                  <div style="flex:1;min-width:0">
                    <div class="pn">${u.display_name || u.username}</div>
                    <div class="pm">@${u.username} · 成员</div>
                    <div class="pm" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${u.bio || '这个人很懒，什么都没写。'}</div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      } catch (e: any) {
        el.innerHTML = `<div class="empty" style="color:var(--danger)">加载失败: ${e.message}</div>`;
      }
    }
    loadMembers();
    document.addEventListener('astro:page-load', loadMembers);
  </script>
  <style>
    .person {
      border-radius: var(--radius-sm);
      padding-inline: 10px;
      margin-inline: -10px;
      transition: background var(--dur-fast) var(--ease-out);
    }
    .person:hover { background: var(--elevated); }
    .person .avatar-sm { transition: transform var(--dur-base) var(--ease-spring); }
    .person:hover .avatar-sm { transform: scale(1.06); }
    .person:active .avatar-sm { transform: scale(0.97); }
  </style>
</Layout>
